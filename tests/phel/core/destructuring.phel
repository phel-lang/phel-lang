(ns phel-test.core.destructuring
  (:require phel.test :refer [deftest is]))

(deftest destructure-vector
  (is (= 3 (let [[a b] [1 2]] (+ a b))) "from vector")
  (is (= 3 (let [[a b] (php-indexed-array 1 2)] (+ a b))) "from php array")
  (is (= 10 (let [[a [c d] b] [1 (list 4 3) 2]] (+ a b c d))) "nested")
  (is (= 4 (let [[a _ b] [1 2 3]] (+ a b))) "ignore value"))

(deftest destructure-hash-map
  (is (= 3 (let [{:a a :b b} {:a 1 :b 2}] (+ a b))) "destructure hash map")
  (is (= 6 (let [{:a [a1 a2] :b b} {:a [1 3] :b 2}] (+ a1 a2 b))) "nested destructure hash map")
  (is (= 3 (let [{:keys [a b]} {:a 1 :b 2}] (+ a b))) "destructure hash map with :keys")
  (is (= {:a 1 :b 2} (let [{:keys [a b] :as user} {:a 1 :b 2}] user)) "destructure hash map with :keys and :as"))

(deftest destructure-hash-map-clojure-order
  (is (= 3 (let [{a :a b :b} {:a 1 :b 2}] (+ a b))) "binding first, as Clojure writes it")
  (is (= 42 (let [{{:keys [c]} :inner} {:inner {:c 42}}] c)) "nested map pattern")
  (is (= 3 (let [{[a1 a2] :a} {:a [1 2]}] (+ a1 a2))) "nested vector pattern")
  (is (= "Alice" (let [{n "name"} {"name" "Alice"}] n)) "string lookup key")
  (is (= 42 (let [{b :b :or {b 42}} {:a 1}] b)) ":or default for an absent key")
  (is (= {:a 1} (let [{a :a :as m} {:a 1}] m)) ":as alongside a binding-first pair")
  (is (= 3 (let [{a :a :keys [b]} {:a 1 :b 2}] (+ a b))) "mixed with a :keys directive"))

(deftest destructure-hash-map-ambiguous-pair-stays-key-first
  ;; Both sides bind, so the left one is still evaluated as the lookup key.
  (is (= 1 (let [k :a] (let [{k v} {:a 1}] v))) "symbol key is evaluated"))

(deftest destructure-hash-map-or-defaults
  (is (= 42 (let [{:keys [a b] :or {b 42}} {:a 1}] b))
      ":or provides default for absent key")
  (is (= 1 (let [{:keys [a b] :or {b 42}} {:a 1}] a))
      "present key unaffected by :or")
  (is (= 99 (let [{:keys [b] :or {b 42}} {:b 99}] b))
      ":or not applied when key is present")
  ;; :or with nil value present — nil wins (Clojure semantics: contains? check)
  (is (nil? (let [{:keys [a] :or {a "default"}} {:a nil}] a))
      ":or not applied when key present with nil value")
  (is (= 99 (let [{:a x :or {x 99}} {}] x))
      ":or works with explicit key bindings")
  (is (= {:a 1} (let [{:keys [a b] :or {b 42} :as m} {:a 1}] m))
      ":as binds the original map regardless of :or")
  (is (= [10 20] (let [{:keys [a b] :or {a 10 b 20}} {}] [a b]))
      ":or applies multiple defaults")
  (is (= 1 (let [{:keys [a] :or {a 10 z 99}} {:a 1}] a))
      ":or for unreferenced keys has no effect")
  (is (= 42 ((fn [{:keys [x] :or {x 42}}] x) {}))
      ":or works in fn parameter destructuring")
  (is (= 7 (let [f (fn [{:keys [a b] :or {b 3}}] (+ a b))]
             (f {:a 4})))
      ":or works in defn-style destructuring"))

(deftest destructure-hash-map-strs
  (is (= "Alice" (let [{:strs [name]} {"name" "Alice"}] name))
      ":strs extracts string key")
  (is (= 30 (let [{:strs [name age]} {"name" "Alice" "age" 30}] age))
      ":strs extracts multiple string keys")
  (is (nil? (let [{:strs [a b]} {"a" 1}] b))
      ":strs returns nil for missing key")
  (is (= {"x" 1 "y" 2} (let [{:strs [x] :as m} {"x" 1 "y" 2}] m))
      ":strs combined with :as binds the full map")
  (is (= "Bob" ((fn [{:strs [name]}] name) {"name" "Bob"}))
      ":strs works in fn parameter destructuring"))

(deftest destructure-hash-map-syms
  (is (= "Alice" (let [{:syms [name]} {'name "Alice"}] name))
      ":syms extracts symbol key")
  (is (= 30 (let [{:syms [name age]} {'name "Alice" 'age 30}] age))
      ":syms extracts multiple symbol keys")
  (is (nil? (let [{:syms [a b]} {'a 1}] b))
      ":syms returns nil for missing key")
  (is (= {'x 1 'y 2} (let [{:syms [x] :as m} {'x 1 'y 2}] m))
      ":syms combined with :as binds the full map")
  (is (= "Bob" ((fn [{:syms [name]}] name) {'name "Bob"}))
      ":syms works in fn parameter destructuring")
  (is (= 42 (let [{:syms [a b] :or {b 42}} {'a 1}] b))
      ":or provides default for absent symbol key")
  (is (= 3 (let [{:syms [a b]} {'a 1 'b 2}] (+ a b)))
      ":syms binds multiple values usable in body"))

(deftest destructure-hash-map-namespaced-keys
  (is (= 5 (let [{:my/keys [a]} {:my/a 5 :a 1}] a))
      ":my/keys reads :my/a, not :a")
  (is (= 5 (let [{::keys [a]} {::a 5 :a 1}] a))
      "::keys reads the key in the current namespace")
  (is (= 5 (let [{:keys [my/a]} {:my/a 5 :a 1}] a))
      "qualified symbol in :keys binds the name part")
  (is (= 5 (let [{:keys [:my/a]} {:my/a 5 :a 1}] a))
      "qualified keyword in :keys binds the name part")
  (is (= 3 (let [{:keys [:a]} {:a 3}] a))
      "plain keyword in :keys")
  (is (= 5 (let [{:my/syms [a]} {'my/a 5 'a 1}] a))
      ":my/syms reads 'my/a")
  (is (= 5 (let [{:syms [my/a]} {'my/a 5 'a 1}] a))
      "qualified symbol in :syms binds the name part")
  (is (= 5 (let [{:my/strs [a]} {"a" 5 "my/a" 1}] a))
      ":my/strs ignores the namespace")
  (is (= [1 2 3] (let [{:keys [a] :my/keys [b] :other/keys [c]} {:a 1 :my/b 2 :other/c 3}] [a b c]))
      "several :keys directives combine"))

(deftest destructure-hash-map-namespaced-keys-or-and-as
  (is (= 1 (let [{:my/keys [a] :or {a 1}} {}] a))
      ":or is keyed on the local name for :my/keys")
  (is (= 1 (let [{::keys [a] :or {a 1}} {}] a))
      ":or is keyed on the local name for ::keys")
  (is (= 1 (let [{:keys [my/a] :or {a 1}} {}] a))
      ":or is keyed on the local name for a qualified symbol")
  (is (= 1 (let [{:keys [:my/a] :or {a 1}} {}] a))
      ":or is keyed on the local name for a qualified keyword")
  (is (= 1 (let [{:my/syms [a] :or {a 1}} {}] a))
      ":or is keyed on the local name for :my/syms")
  (is (= 1 (let [{:my/strs [a] :or {a 1}} {}] a))
      ":or is keyed on the local name for :my/strs")
  (is (= [5 {:my/a 5}] (let [{:my/keys [a] :as m} {:my/a 5}] [a m]))
      ":as binds the whole map next to :my/keys")
  (is (= [5 {::a 5}] (let [{::keys [a] :as m} {::a 5}] [a m]))
      ":as binds the whole map next to ::keys"))

(deftest destructure-hash-map-namespaced-keys-in-fn
  (is (= 5 ((fn [{:my/keys [a]}] a) {:my/a 5})) ":my/keys in fn params")
  (is (= 5 ((fn [{::keys [a]}] a) {::a 5})) "::keys in fn params")
  (is (= 5 ((fn [{:keys [my/a]}] a) {:my/a 5})) "qualified symbol in fn params")
  (is (= 5 ((fn [{:keys [:my/a]}] a) {:my/a 5})) "qualified keyword in fn params")
  (is (= 5 ((fn [{:my/syms [a]}] a) {'my/a 5})) ":my/syms in fn params")
  (is (= 5 ((fn [{:my/strs [a]}] a) {"a" 5})) ":my/strs in fn params")
  (is (= [7 {}] ((fn [{:my/keys [a] :or {a 7} :as m}] [a m]) {}))
      ":or and :as in fn params"))

(deftest destructure-hash-map-namespaced-keys-in-loop
  (is (= 5 (loop [{:my/keys [a]} {:my/a 5}] a)) ":my/keys in loop")
  (is (= 5 (loop [{::keys [a]} {::a 5}] a)) "::keys in loop")
  (is (= 5 (loop [{:keys [my/a]} {:my/a 5}] a)) "qualified symbol in loop")
  (is (= 5 (loop [{:keys [:my/a]} {:my/a 5}] a)) "qualified keyword in loop")
  (is (= 5 (loop [{:my/syms [a]} {'my/a 5}] a)) ":my/syms in loop")
  (is (= 5 (loop [{:my/strs [a]} {"a" 5}] a)) ":my/strs in loop")
  (is (= [3 {:my/a 3}]
         (loop [{:my/keys [a] :or {a 0} :as m} {}]
           (if (< a 3) (recur {:my/a (inc a)}) [a m])))
      ":or and :as across recur in loop"))

(deftest destructure-map-pattern-over-a-seq-reads-kwargs
  (is (= 1 (let [{:keys [a]} '(:a 1)] a)) "a list reads as key/value pairs")
  (is (= 1 (let [{:keys [a]} (map identity [:a 1])] a)) "so does a lazy seq")
  (is (= 2 (let [{:keys [b]} (next (map identity [:z :a 1 :b 2]))] b)) "and a Cons cell")
  (is (= {:a 1 :b 2} (let [{:as m} '(:a 1 :b 2)] m)) ":as binds the map the seq reads as")
  (is (= 3 (let [{:keys [a]} '(:a 1 :a 3)] a)) "a later key wins, as by assoc")
  (is (= 2 (let [{:keys [a]} (list :a 1 {:a 2})] a)) "a trailing map merges over the pairs")
  (is (= 5 (let [{:keys [a]} (list {:a 5})] a)) "a lone map is the map")
  (is (nil? (let [{:keys [a]} '()] a)) "an empty seq has no keys")
  (is (= 7 (let [{:keys [a] :or {a 7}} '(:b 1)] a)) ":or still fills a missing key")
  (is (thrown-with-msg? InvalidArgumentException "No value supplied for key: :b"
                        (let [{:keys [a]} '(:a 1 :b)] a))
      "a dangling key that is not a map fails as in Clojure"))

(deftest destructure-map-pattern-over-a-set-reads-through-get
  (is (= :a (let [{:keys [a]} #{:a}] a)) "a member reads as itself")
  (is (nil? (let [{:keys [b]} #{:a}] b)) "a missing member is nil")
  (is (= #{:a} (let [{:as s} #{:a}] s)) ":as binds the set itself")
  (is (= :x (let [{:keys [b] :or {b :x}} #{:a}] b)) ":or fills a missing member"))

(deftest destructure-map-pattern-over-other-values
  (is (nil? (let [{:keys [a]} nil] a)) "nil has no keys")
  (is (= :y (let [{y 1} [:x :y]] y)) "a vector reads by index")
  (is (= 1 (let [{:strs [a]} (php-associative-array "a" 1)] a)) "a php array reads by string key")
  (is (nil? (let [{:keys [a]} :a] a)) "a keyword has no keys"))
