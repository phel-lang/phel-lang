(ns phel-test.core.guarded-untyped-arithmetic
  (:require phel.test :refer [deftest is]))

;; Binary `+`, `-` and `*` over untyped operands compile to the native operator
;; behind an `is_int` guard, with the runtime fn as the fallback (#3468). Each
;; lowered form is checked against `apply`, which always reaches the runtime
;; fn, over native ints at the bounds, floats, NaN, BigInt, ratios and nil. The
;; result type is compared too: `(= 1 (bigint 1))` would hide a lost promotion.

(defn- outcome [f]
  (try (f) (catch \Throwable _ :threw)))

(def- numbers
  [0 1 -1 3 php/PHP_INT_MAX php/PHP_INT_MIN (php/intdiv php/PHP_INT_MAX 2)
   1.0 0.0 -2.5 (php/fdiv 0 0) (bigint 1) (bigint 3) (/ 1 3) nil])

(defn- same? [a b]
  (and (= (php/get_debug_type a) (php/get_debug_type b))
       (if (and (float? a) (php/is_nan a))
         (php/is_nan b)
         (= a b))))

(deftest test-arithmetic-over-two-locals
  (doseq [a numbers b numbers]
    (is (same? (outcome #(apply + [a b])) (outcome #(+ a b))) (str "(+ " (pr-str a) " " (pr-str b) ")"))
    (is (same? (outcome #(apply - [a b])) (outcome #(- a b))) (str "(- " (pr-str a) " " (pr-str b) ")"))
    (is (same? (outcome #(apply * [a b])) (outcome #(* a b))) (str "(* " (pr-str a) " " (pr-str b) ")"))))

(deftest test-arithmetic-against-an-int-literal
  (doseq [a numbers]
    (is (same? (outcome #(apply + [a 1])) (outcome #(+ a 1))) (str "(+ " (pr-str a) " 1)"))
    (is (same? (outcome #(apply - [-1 a])) (outcome #(- -1 a))) (str "(- -1 " (pr-str a) ")"))
    (is (same? (outcome #(apply * [a -2])) (outcome #(* a -2))) (str "(* " (pr-str a) " -2)"))))

(deftest test-overflow-promotes-to-bigint
  (let [hi php/PHP_INT_MAX
        lo php/PHP_INT_MIN]
    (is (bigint? (+ hi 1)))
    (is (bigint? (- lo 1)))
    (is (bigint? (* hi 2)))
    (is (bigint? (* lo -1)))))

;; An operand that is not a local or a literal is evaluated once, in order,
;; whichever branch the guard takes.
(deftest test-spilled-operands-run-once-in-order
  (doseq [x numbers y numbers]
    (let [log (atom [])
          f   (fn [tag v] (swap! log conj tag) v)]
      (outcome #(+ (f :a x) (f :b y)))
      (outcome #(- (f :c x) 1))
      (outcome #(* 2 (f :d y)))
      (is (= [:a :b :c :d] @log) (str "operands " (pr-str x) " " (pr-str y))))))
