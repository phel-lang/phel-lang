(ns phel-test.core.map-filter-arities
  (:require phel.test :refer [deftest is thrown?]))

;; `map` and `filter` declare fixed arities instead of `[f & args]` plus
;; `(case (count args) ...)` (#3021 A2). Both spellings accept the same calls,
;; so what has to be pinned is that every one of them still routes where it did:
;; the transducer, the single collection, the multi-collection tail that only
;; `map` has, and the argument-count error that only `filter` raises.

(deftest test-map-single-collection
  (is (= [2 3 4] (vec (map inc [1 2 3]))) "over a vector")
  (is (= [2 3 4] (vec (map inc (list 1 2 3)))) "over a list")
  (is (= [] (vec (map inc []))) "over an empty collection")
  (is (= [] (vec (map inc nil))) "over nil")
  ;; `(str :a)` keeps the colon, so this is ":a" and not "a".
  (is (= [":a" ":b"] (vec (map str [:a :b]))) "over keywords"))

;; A map iterates as `[key value]` pairs, which is Clojure-aligned and easy to
;; lose when the collection stops arriving through `first`.
(deftest test-map-over-an-associative-collection
  (is (= [:a :b] (vec (map first {:a 1, :b 2}))) "keys come from the pair")
  (is (= [1 2] (vec (map second {:a 1, :b 2}))) "values come from the pair")
  (is (= [[:a 1] [:b 2]] (vec (map identity {:a 1, :b 2}))) "the element is the pair"))

(deftest test-map-multiple-collections
  (is (= [11 22 33] (vec (map + [1 2 3] [10 20 30]))) "two collections")
  (is (= [111 222] (vec (map + [1 2] [10 20] [100 200]))) "three collections")
  (is (= [11 22] (vec (map + [1 2] [10 20 30]))) "stops at the shortest")
  (is (= [] (vec (map + [] [1 2]))) "an empty collection stops it immediately"))

(deftest test-map-transducer
  (is (= [2 3 4] (into [] (map inc) [1 2 3])) "one argument returns a transducer")
  (is (= [3 4 5] (into [] (comp (map inc) (map inc)) [1 2 3])) "composed with itself"))

(deftest test-map-preserves-metadata
  (is (= {:m 1} (meta (map inc (with-meta [1 2] {:m 1})))) "single collection")
  (is (= {:m 1} (meta (map + (with-meta [1 2] {:m 1}) [3 4])))
      "multi-collection copies from the first"))

(deftest test-filter-single-collection
  (is (= [2 4] (vec (filter even? [1 2 3 4]))) "over a vector")
  (is (= [2 4] (vec (filter even? (list 1 2 3 4)))) "over a list")
  (is (= [] (vec (filter even? []))) "over an empty collection")
  (is (= [] (vec (filter even? [1 3 5]))) "nothing matches")
  (is (= [1 2 3] (vec (filter some? [1 2 3]))) "everything matches"))

;; nil is a legitimate element, so a predicate that keeps it must keep it.
(deftest test-filter-keeps-a-nil-that-the-predicate-accepts
  (is (= [nil] (vec (filter nil? [1 nil 2]))) "nil survives the filter")
  (is (= [1 2] (vec (filter some? [1 nil 2]))) "and is dropped when rejected"))

(deftest test-filter-transducer
  (is (= [2 4] (into [] (filter even?) [1 2 3 4])) "one argument returns a transducer")
  (is (= [4] (into [] (comp (filter even?) (filter #(php/> % 2))) [1 2 3 4])) "composed"))

(deftest test-filter-preserves-metadata
  (is (= {:m 1} (meta (filter even? (with-meta [1 2] {:m 1})))) "metadata is copied"))

;; The tail exists only to keep this error. Without it an over-long call would
;; fail on arity dispatch with a different exception and a worse message.
(deftest test-filter-rejects-too-many-arguments
  (is (thrown? \InvalidArgumentException (filter even? [1 2] [3 4])) "three arguments")
  (is (thrown? \InvalidArgumentException (filter even? [1] [2] [3])) "four arguments"))

(deftest test-filter-reports-the-message-it-always-did
  (let [msg (try
              (filter even? [1 2] [3 4])
              nil
              (catch \InvalidArgumentException e (.getMessage e)))]
    (is (= "filter expects 1 or 2 arguments" msg) "the original wording is kept")))

;; Laziness is the property most easily lost when a body moves between arities.
(deftest test-both-stay-lazy
  (is (= [1 2 3] (vec (take 3 (map inc (iterate inc 0))))) "map over an unbounded source")
  (is (= [0 2 4] (vec (take 3 (filter even? (iterate inc 0))))) "filter over an unbounded source"))
