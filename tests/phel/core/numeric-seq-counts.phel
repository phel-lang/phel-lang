(ns phel-test.core.numeric-seq-counts
  (:require phel.test :refer [deftest is testing thrown?]))

(deftest test-take-counts-down-a-non-int-count
  (is (= '(0 1 2) (take 5/2 (range 10))))
  (is (= '(0 1 2) (take 2.5 (range 10))))
  (is (= '(0 1) (take 2N (range 10))))
  (is (= '(0 1 2) (take 2.5M (range 10))))
  (is (= '() (take -1/2 (range 10)))))

(deftest test-drop-counts-down-a-non-int-count
  (is (= '(3 4 5) (drop 5/2 (range 6))))
  (is (= '(3 4 5) (drop 2.5 (range 6))))
  (is (= '(2 3 4 5) (drop 2N (range 6))))
  (is (= '(3 4 5) (drop 2.5M (range 6))))
  (is (= '() (drop 100000000000000000000N (range 6)))))

(deftest test-drop-last-counts-down-a-non-int-count
  (is (= '(0 1 2) (drop-last 5/2 (range 6))))
  (is (= '(0 1 2) (drop-last 2.5 (range 6))))
  (is (= '(0 1 2 3) (drop-last 2N (range 6)))))

(deftest test-take-last-counts-down-a-non-int-count
  (is (= '(3 4 5) (take-last 5/2 (range 6))))
  (is (= '(3 4 5) (take-last 2.5 (range 6))))
  (is (= [3 4 5] (take-last 5/2 [0 1 2 3 4 5])))
  (is (= [4 5] (take-last 2N [0 1 2 3 4 5]))))

(deftest test-take-nth-steps-by-the-rounded-up-count
  (is (= '(0 3 6 9) (take-nth 5/2 (range 10))))
  (is (= '(0 3 6 9) (take-nth 2.5 (range 10))))
  (is (= '(0 2 4 6 8) (take-nth 2N (range 10)))))

(deftest test-split-at-counts-down-a-non-int-count
  (is (= ['(0 1 2) '(3 4 5)] (split-at 5/2 (range 6))))
  (is (= ['(0 1 2) '(3 4 5)] (split-at 2.5 (range 6))))
  (is (= ['(0 1) '(2 3 4 5)] (split-at 2N (range 6)))))

(deftest test-partition-keeps-only-chunks-equal-to-the-count
  (testing "a chunk of 3 items never equals a count of 5/2 or 2.5"
           (is (= '() (partition 5/2 (range 10))))
           (is (= '() (partition 2.5 (range 10))))
           (is (= '() (partition 2.5 2 (range 10)))))
  (is (= '([0 1] [2 3]) (partition 2N (range 5)))))

(deftest test-repeatedly-counts-down-a-non-int-count
  (is (= '(0 0) (repeatedly 1.5 +)))
  (is (= '(0) (repeatedly 1/2 +)))
  (is (= '() (repeatedly -1 +)))
  (is (= '(0 0) (repeatedly 2N +)))
  (is (= '(0 0 0) (repeatedly 2.5M +)))
  (is (= '() (repeatedly -10000000000000000000N +)))
  (is (= '() (repeatedly ##NaN +)))
  (is (= '() (repeatedly ##-Inf +)))
  (is (= '(0 0) (take 2 (repeatedly ##Inf +)))))

(deftest test-nthnext-counts-down-a-non-int-count
  (is (nil? (nthnext [1 2 3] 5/2)))
  (is (= '(3) (nthnext [1 2 3] 1.5)))
  (is (= '(2 3) (nthnext [1 2 3] 1N)))
  (is (= '(3) (nthnext [1 2 3] 1.5M))))

(deftest test-repeatedly-keeps-an-exact-count-exact
  (is (= 2 (count (repeatedly 100000000000000000001/100000000000000000000 +))))
  (is (= 2 (count (repeatedly 1.0000000000000000001M +)))))

(deftest test-nthnext-with-a-nan-count-drops-nothing
  (is (= '(1 2 3) (nthnext [1 2 3] ##NaN))))

(deftest test-count-transducers-round-up-a-non-int-count
  (is (= [2 3] (into [] (drop 1/2) [1 2 3])))
  (is (= [1] (into [] (take 1/2) [1 2 3])))
  (is (= [0 3 6] (into [] (take-nth 2.5M) [0 1 2 3 4 5 6])))
  (is (= [0 3 6] (into [] (take-nth 2.5) [0 1 2 3 4 5 6]))))

(deftest test-bounded-count-counts-down-a-non-int-bound
  (is (= 3 (bounded-count 5/2 (map identity [1 2 3 4])))))

(deftest test-an-empty-coll-returns-before-the-count-is-checked
  (is (nil? (nthnext nil nil)))
  (is (nil? (nthnext [] "")))
  (is (= 0 (bounded-count nil (map identity [])))))

(deftest test-a-nan-count-means-zero
  (is (= [1 2] (drop ##NaN [1 2])))
  (is (= [] (take ##NaN [1 2]))))

(def- non-number-counts ["" "a" [] {} #{} '() (atom 0) (fn []) :k true false nil])

(deftest test-a-non-number-count-throws
  (doseq [n non-number-counts]
    (is (thrown? \InvalidArgumentException (first (repeatedly n +))) (str "repeatedly " (pr-str n)))
    (is (thrown? \InvalidArgumentException (drop n [1 2])) (str "drop " (pr-str n)))
    (is (thrown? \InvalidArgumentException (drop-last n [1 2])) (str "drop-last " (pr-str n)))
    (is (thrown? \InvalidArgumentException (take-nth n [1 2])) (str "take-nth " (pr-str n)))
    (is (thrown? \InvalidArgumentException (nthnext [1 2] n)) (str "nthnext " (pr-str n)))
    (is (thrown? \InvalidArgumentException (drop n nil)) (str "drop on nil " (pr-str n)))
    (is (thrown? \InvalidArgumentException (drop-last n nil)) (str "drop-last on nil " (pr-str n)))
    (is (thrown? \InvalidArgumentException (bounded-count n (map identity [1 2]))) (str "bounded-count " (pr-str n)))
    (is (thrown? \InvalidArgumentException (drop n)) (str "drop transducer " (pr-str n)))
    (is (thrown? \InvalidArgumentException (take n)) (str "take transducer " (pr-str n)))
    (is (thrown? \InvalidArgumentException (take-nth n)) (str "take-nth transducer " (pr-str n)))))
