(ns phel-test.core.regex-functions
  (:require phel.test :refer [deftest is]))

(deftest test-re-seq
  (let [input "Hello, 1 regex 2 test"]
    (is (= ["1" "2"] (re-seq "/\d+/" input)) "regex [0-9]")
    (is (= ["Hello" "1" "regex" "2" "test"] (re-seq "/\w+/" input)) "regex [a-zA-Z0-9_]")))

(deftest test-re-seq-doesnt-match
  (let [input "Hello, one regex two test"]
    (is (= [] (re-seq "/\d+/" input)) "regex [0-9] doesn't match")))

(deftest test-re-seq-with-capture
  (let [input    "one=1 two=2 none="
        expected [["one=1" "one" "1"]
                  ["two=2" "two" "2"]
                  ["none=" "none" ""]]]
    (is (= expected (re-seq "/(\w+)=(\w*)/" input)) "regex with capture")))

(deftest test-re-seq-with-capture-doesnt-match
  (let [input "one,1 two,2 none,"]
    (is (= [] (re-seq "/(\w+)=(\w*)/" input)) "regex with capture doesn't match")))

;; --- re-find ---

(deftest test-re-find
  (is (= "123" (re-find "/\\d+/" "abc123def")) "re-find returns first match")
  (is (nil? (re-find "/\\d+/" "abcdef")) "re-find returns nil on no match"))

(deftest test-re-find-with-groups
  (is (= ["12-34" "12" "34"] (re-find "/(\\d+)-(\\d+)/" "abc12-34def"))
      "re-find with groups returns vector"))

(deftest test-re-find-zero-length-match
  (is (= "" (re-find "/a*/" "bbb"))
      "a zero-length match is the empty string, distinct from nil for no match"))

(deftest test-re-find-unmatched-optional-group
  (is (= ["12" "12"] (re-find "/(\\d+)(x)?/" "12"))
      "a trailing optional group that did not participate is absent from the vector"))

(deftest test-re-find-named-group-shape
  ;; Named groups do not return the flat vector the docstring describes: PHP
  ;; fills the match array under both the name and the number, and every entry
  ;; survives as a pair. Pinned rather than endorsed - reading the match array
  ;; in match order is what makes it stable enough to pin at all.
  (is (= [[0 "123"] ["x" "123"] [1 "123"]] (re-find "/(?<x>\\d+)/" "abc123def"))
      "a named group yields key/value pairs in the order PHP filled them"))

;; --- re-matches ---

(deftest test-re-matches
  (is (= "12345" (re-matches "/\\d+/" "12345")) "re-matches full string")
  (is (nil? (re-matches "/\\d+/" "abc123")) "re-matches requires full string match"))

(deftest test-re-matches-with-groups
  (is (= ["12-34" "12" "34"] (re-matches "/(\\d+)-(\\d+)/" "12-34"))
      "re-matches with groups"))

(deftest test-re-matches-backtracks-to-a-full-match
  (is (= "ab" (re-matches #"a|ab" "ab")) "a later alternative covers the whole string")
  (is (= "aaa" (re-matches #"a+?" "aaa")) "a lazy quantifier extends to the whole string")
  (is (= ["ab" "ab"] (re-matches #"(a|ab)" "ab")) "groups keep their shape")
  (is (= "ab" (re-matches "/A|AB/i" "ab")) "modifiers still apply")
  (is (= "ab" (re-matches "{a|ab}" "ab")) "bracket delimiters")
  (is (= "ab" (re-matches "/a | ab # trailing comment/x" "ab")) "extended mode with a trailing comment")
  (is (= "éa" (re-matches "/(*UTF8)é|éa/u" "éa")) "a leading verb stays first")
  (is (nil? (re-matches #"abc" "xabcx")) "a match inside the string is not enough")
  (is (nil? (re-matches #"a$" "a\n")) "a trailing newline is not part of a match")
  (is (= "a" (re-matches "/(*F)|a/" "a")) "a verb that is part of the pattern stays in place")
  (is (= "ac" (re-matches "/(*atomic:a|ab)c/" "ac")) "an atomic group stays in place")
  (is (nil? (re-matches "/(*ACCEPT)a/" "xyz")) "an early accept is not a full match")
  (is (= "ab" (re-matches #"(?x)a|ab # trailing comment" "ab")) "inline extended mode with a trailing comment")
  (is (= "ab" (re-matches "/a\\Qb/" "ab")) "a quote left open at the end")
  (is (nil? (re-matches "/a\\Kb/" "ab")) "a reset match start is not a full match")
  (is (nil? (re-matches " /a/" "xax")) "a pattern with leading whitespace still needs a full match"))

;; --- #"..." regex literal syntax ---

(deftest test-regex-literal-re-find
  (is (= "123" (re-find #"\d+" "abc123def")) "regex literal with re-find")
  (is (nil? (re-find #"\d+" "abcdef")) "regex literal no match"))

(deftest test-regex-literal-re-find-groups
  (is (= ["12-34" "12" "34"] (re-find #"(\d+)-(\d+)" "abc12-34def"))
      "regex literal with capture groups"))

(deftest test-regex-literal-re-matches
  (is (= "12345" (re-matches #"\d+" "12345")) "regex literal full match")
  (is (nil? (re-matches #"\d+" "abc123")) "regex literal requires full match"))

(deftest test-regex-literal-re-seq
  (is (= ["1" "2" "3"] (re-seq #"\d+" "a1b2c3")) "regex literal with re-seq"))

(deftest test-regex-literal-case-insensitive
  (is (= "HELLO" (re-find #"(?i)hello" "HELLO world"))
      "regex literal with inline flags"))

(deftest test-regex-literal-with-special-chars
  (is (= "." (re-find #"\." "a.b")) "regex literal escaping dot")
  (is (= "abc" (re-find #"\w+" "abc 123")) "regex literal word chars"))

(deftest test-regex-literal-is-string
  (is (= "/\\d+/" #"\d+") "regex literal produces delimited string"))

(deftest test-regex-literal-with-slash
  (is (= "a/b" (re-find #"a/b" "test a/b end")) "regex with forward slash"))

(deftest test-regex-literal-slash-after-backslashes
  (is (= "/" (re-matches #"/" "/")))
  (is (= "/" (re-matches #"\/" "/")))
  (is (= "\\/" (re-matches #"\\/" "\\/")))
  (is (= "\\/" (re-matches #"\\\/" "\\/")))
  (is (= "//" (re-matches #"//" "//")))
  (is (= "abc" (re-matches #"abc" "abc"))))

(deftest test-regex-literal-url-pattern
  (is (= "https://example.com" (re-find #"https?://[^\s]+" "visit https://example.com now"))
      "regex matching URL with slashes"))

(deftest test-re-pattern
  (is (= "/\\d+/" (re-pattern "\\d+")) "re-pattern wraps in delimiters")
  (is (= "/\\d+/" (re-pattern "/\\d+/")) "re-pattern passes through delimited"))

(deftest test-re-pattern-with-re-find
  (is (= "42" (re-find (re-pattern "\\d+") "abc42def")) "re-pattern result works with re-find"))
