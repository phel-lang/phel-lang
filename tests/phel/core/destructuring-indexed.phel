(ns phel-test.core.destructuring-indexed
  (:require phel.test :refer [deftest is]))

;; Sequential destructuring reads a vector by index and walks everything else
;; with `first`/`next` (#3356). Each case below states what the walk answers,
;; so a vector and a non-vector are held to the same result.

(defn- walk2
  "What `[a b & r]` bound before the indexed path: two `first`/`next` steps."
  [v]
  (let [s1 (next v)
        s2 (next s1)]
    [(first v) (first s1) s2]))

(defn- rest-shape [x]
  [(php/get_debug_type x) x (meta x)])

(defn- destructure2 [v]
  (let [[a b & r] v] [a b r]))

(def- inputs
  [[1 2 3]
   [1 2 3 4 5]
   [1]
   []
   [nil nil 3]
   (with-meta [1 2 3 4] {:m 1})
   (subvec [0 1 2 3 4 5] 1 5)
   (next [0 1 2 3])
   '(1 2 3 4)
   (map inc [1 2 3 4])
   #{1 2 3}
   {:a 1 :b 2 :c 3}
   "héllo"
   nil
   (php/array 1 2 3 4)
   (cons 0 [1 2 3])
   (queue 1 2 3)])

(deftest vector-positions-read-by-index
  (is (= [1 2 nil] (let [[a b c] [1 2]] [a b c])) "missing positions bind nil")
  (is (= [nil nil] (let [[a b] []] [a b])) "empty vector")
  (is (= [nil 2] (let [[a b] [nil 2]] [a b])) "a nil element is not the end")
  (is (= 3 (let [[_ _ c] [1 2 3]] c)) "ignored positions still count")
  (is (= [3 4] (let [[a b] (subvec [1 2 3 4 5] 2 4)] [a b])) "a subvector reads from its own start"))

(deftest non-vectors-keep-the-walk
  (is (= [1 2 3] (let [[a b c] '(1 2 3 4)] [a b c])) "list")
  (is (= [2 3] (let [[a b] (map inc [1 2 3])] [a b])) "lazy seq")
  (is (= [0 1 2] (let [[a b c] (range)] [a b c])) "infinite seq")
  (is (= #{1 2} (let [[a b] #{1 2}] (hash-set a b))) "set")
  (is (= [[:a 1] [:b 2]] (let [[a b] {:a 1 :b 2}] [a b])) "map entries")
  (is (= ["h" "é"] (let [[a b] "héllo"] [a b])) "multibyte string")
  (is (= [nil nil] (let [[a b] nil] [a b])) "nil")
  (is (= [1 2] (let [[a b] (php/array 1 2 3)] [a b])) "php array")
  (is (= [:a 1 nil] (let [[k v x] (first {:a 1})] [k v x])) "map entry"))

(deftest rest-is-what-next-returns
  (is (nil? (let [[a b & r] [1 2]] r)) "exhausted vector rest is nil, not empty")
  (is (nil? (let [[a b & r] [1]] r)) "short vector rest is nil")
  (is (= [2 3] (let [[_ & r] [1 2 3]] r)) "rest after one")
  (is (= (rest-shape (next [1 2 3])) (let [[_ & r] [1 2 3]] (rest-shape r)))
      "same type as next")
  (is (= {:m 1} (meta (let [[_ _ & r] (with-meta [1 2 3 4] {:m 1})] r)))
      "rest keeps the vector metadata, as next does")
  (let [v [1 2 3]]
    (is (identical? v (let [[& r] v] r)) "a bare rest is the value itself"))
  (is (= [4 5] (let [[_ _ _ & r] (subvec [0 1 2 3 4 5 6] 1 6)] r)) "rest of a subvector")
  (is (= '(3 4) (let [[_ _ & r] '(1 2 3 4)] r)) "list rest stays a list")
  (is (= [2 3 4] (take 3 (let [[_ _ & r] (range)] r))) "infinite rest"))

(deftest nested-patterns
  (is (= [1 2 3 4 5] (let [[[a b] [c d] e] [[1 2] [3 4] 5]] [a b c d e])) "vectors in a vector")
  (is (= [1 2 3] (let [[[a b] c] ['(1 2) 3]] [a b c])) "list in a vector")
  (is (= [1 2 3] (let [[[a b] c] (list [1 2] 3)] [a b c])) "vector in a list")
  (is (= [1 [3]] (let [[a & [b & r]] [1 2 3]] [a r])) "pattern on the rest")
  (is (= 2 (let [[a & [b]] [1 2 3]] b)) "positional pattern on the rest")
  (is (= [1 3] (let [[a {:keys [c]}] [1 {:c 3}]] [a c])) "map pattern inside"))

(deftest fn-and-loop-patterns
  (is (= 3 ((fn [[a b]] (+ a b)) [1 2])) "fn param")
  (is (= 3 ((fn [[a b]] (+ a b)) '(1 2))) "fn param, list")
  (is (= 10 (loop [[x & xs] [1 2 3 4] acc 0]
              (if x (recur xs (+ acc x)) acc)))
      "loop over a vector")
  (is (= [[1 2] [3 4]] (for [[a b] :in [[1 2] [3 4]]] [a b])) "for binding"))

(deftest matches-the-first-next-walk
  (doseq [v inputs]
    (is (= (walk2 v) (destructure2 v)) (str "values for " (pr-str v)))
    (is (= (rest-shape (get (walk2 v) 2)) (rest-shape (get (destructure2 v) 2)))
        (str "rest type and meta for " (pr-str v)))))

(defn- counting-seq [counter n]
  (lazy-seq
    (when (< n 5)
      (swap! counter inc)
      (cons n (counting-seq counter (inc n))))))

(deftest realizes-the-same-cells-as-the-walk
  (let [walked       (atom 0)
        destructured (atom 0)]
    (walk2 (counting-seq walked 0))
    (destructure2 (counting-seq destructured 0))
    (is (= @walked @destructured) "same number of realized cells")))

(deftest keeps-the-walk-errors
  (is (thrown? \InvalidArgumentException (let [[a b] 5] a)) "a scalar still fails in next")
  (is (thrown? \InvalidArgumentException (let [[[x y]] [1]] x)) "a nested scalar still fails"))
