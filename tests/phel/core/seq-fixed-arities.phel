(ns phel-test.core.seq-fixed-arities
  (:require phel.test :refer [deftest is thrown?]))

;; Twelve seq functions plus `slice` declare fixed arities instead of
;; `[x & args]` and `(case (count args) ...)` (#3021 A2, A3). Both spellings
;; accept the same calls, so what has to be pinned is that each one still
;; routes where it did: the transducer arity, the collection arity, nil and
;; empty input, and the multi-collection tail that only `mapcat` has.

(def- nums [1 2 3 4 5 6])

(deftest test-collection-arity
  (is (= [1 2] (vec (take 2 nums))) "take")
  (is (= [3 4 5 6] (vec (drop 2 nums))) "drop")
  (is (= [1 2] (vec (take-while #(< % 3) nums))) "take-while")
  (is (= [3 4 5 6] (vec (drop-while #(< % 3) nums))) "drop-while")
  (is (= [1 3 5] (vec (take-nth 2 nums))) "take-nth")
  (is (= [1 3 5] (vec (remove even? nums))) "remove")
  (is (= [2 4 6] (vec (keep #(when (even? %) %) nums))) "keep")
  (is (= [1 3 5] (vec (keep-indexed (fn [i x] (when (even? i) x)) nums))) "keep-indexed")
  (is (= [1 1 2 2] (vec (mapcat (fn [x] [x x]) [1 2]))) "mapcat")
  (is (= [1 0 2 0 3] (vec (interpose 0 [1 2 3]))) "interpose")
  (is (= [1 2 3 1] (vec (dedupe [1 1 2 2 2 3 1 1]))) "dedupe")
  (is (= [1 2 3] (vec (distinct [1 2 1 3 2]))) "distinct"))

(deftest test-collection-arity-over-nil-and-empty
  (foreach [[label f] [["take" (fn [c] (take 2 c))]
                       ["drop" (fn [c] (drop 2 c))]
                       ["take-while" (fn [c] (take-while even? c))]
                       ["drop-while" (fn [c] (drop-while even? c))]
                       ["take-nth" (fn [c] (take-nth 2 c))]
                       ["remove" (fn [c] (remove even? c))]
                       ["keep" (fn [c] (keep identity c))]
                       ["keep-indexed" (fn [c] (keep-indexed (fn [_i x] x) c))]
                       ["mapcat" (fn [c] (mapcat vector c))]
                       ["interpose" (fn [c] (interpose 0 c))]
                       ["dedupe" (fn [c] (dedupe c))]
                       ["distinct" (fn [c] (distinct c))]]]
    (is (= [] (vec (f nil))) (str label " over nil"))
    (is (= [] (vec (f []))) (str label " over an empty vector"))))

(deftest test-transducer-arity
  ;; The one-argument (or zero-argument) call still returns a transducer, not a
  ;; result. Each is exercised through `transduce` so the arity is really used.
  (is (= [1 2] (transduce (take 2) conj [] nums)) "take")
  (is (= [3 4 5 6] (transduce (drop 2) conj [] nums)) "drop")
  (is (= [1 2] (transduce (take-while #(< % 3)) conj [] nums)) "take-while")
  (is (= [3 4 5 6] (transduce (drop-while #(< % 3)) conj [] nums)) "drop-while")
  (is (= [1 3 5] (transduce (take-nth 2) conj [] nums)) "take-nth")
  (is (= [1 3 5] (transduce (remove even?) conj [] nums)) "remove")
  (is (= [2 4 6] (transduce (keep #(when (even? %) %)) conj [] nums)) "keep")
  (is (= [1 3 5] (transduce (keep-indexed (fn [i x] (when (even? i) x))) conj [] nums)) "keep-indexed")
  (is (= [1 1 2 2] (transduce (mapcat (fn [x] [x x])) conj [] [1 2])) "mapcat")
  (is (= [1 0 2 0 3] (transduce (interpose 0) conj [] [1 2 3])) "interpose")
  (is (= [1 2 3 1] (transduce (dedupe) conj [] [1 1 2 2 2 3 1 1])) "dedupe")
  (is (= [1 2 3] (transduce (distinct) conj [] [1 2 1 3 2])) "distinct"))

(deftest test-mapcat-multi-collection-tail
  ;; The only one of the twelve whose rest argument is a real case rather than
  ;; an error, so it keeps it.
  (is (= [:a 1 :b 2 :c 3] (vec (mapcat list [:a :b :c] [1 2 3]))) "two collections")
  (is (= [:a 1 :x :b 2 :y] (vec (mapcat list [:a :b] [1 2] [:x :y]))) "three collections")
  (is (= [:a 1] (vec (mapcat list [:a :b :c] [1]))) "stops at the shortest"))

(deftest test-take-still-rejects-a-non-integer-count
  (is (thrown? \InvalidArgumentException (take "2" nums)))
  (is (thrown? \InvalidArgumentException (take 1.5 nums))))

(deftest test-slice-arities
  (is (= [2 3 4] (vec (slice [1 2 3 4 5] 1 3))) "offset and length")
  (is (= [2 3 4 5] (vec (slice [1 2 3 4 5] 1))) "offset only runs to the end")
  (is (= [4 5] (vec (slice [1 2 3 4 5] -2))) "a negative offset counts from the end")
  (is (= [3 4 5] (vec (take-last 3 [1 2 3 4 5]))) "take-last routes through slice"))

(deftest test-metadata-survives-the-split
  ;; Each collection arity ends in `copy-meta`; the split must not drop it.
  (let [tagged (with-meta [1 2 3 4] {:tag :kept})]
    (is (= {:tag :kept} (meta (take 2 tagged))) "take")
    (is (= {:tag :kept} (meta (drop 2 tagged))) "drop")
    (is (= {:tag :kept} (meta (keep identity tagged))) "keep")
    (is (= {:tag :kept} (meta (distinct tagged))) "distinct")))
