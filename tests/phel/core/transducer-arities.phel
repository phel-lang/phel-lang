(ns phel-test.core.transducer-arities
  (:require phel.test :refer [deftest is thrown?]))

(deftest test-map-indexed-transducer
  (is (= [[0 :a] [1 :b]] (into [] (map-indexed vector) [:a :b])))
  (is (= [[0 :a] [1 :b]] (sequence (map-indexed vector) [:a :b])))
  (is (= [] (into [] (map-indexed vector) []))))

(deftest test-map-indexed-transducer-stops-early
  (is (= [[0 :a] [1 :b]] (into [] (comp (map-indexed vector) (take 2)) [:a :b :c :d]))))

(deftest test-map-indexed-transducer-state-is-per-transduction
  (let [xf (map-indexed vector)]
    (is (= [[0 :a] [1 :b]] (into [] xf [:a :b])))
    (is (= [[0 :c]] (into [] xf [:c])) "the index restarts at 0")))

(deftest test-partition-by-transducer
  (is (= [[1 3] [2 4] [5]] (into [] (partition-by odd?) [1 3 2 4 5])))
  (is (= [[1 3] [2 4] [5]] (sequence (partition-by odd?) [1 3 2 4 5])))
  (is (= [[1 3] [2 4] [5]] (transduce (partition-by odd?) conj [1 3 2 4 5]))
      "transduce flushes the buffered tail")
  (is (= [] (into [] (partition-by odd?) []))))

(deftest test-partition-by-transducer-stops-early
  (is (= [[1 3] [2 4]] (into [] (comp (partition-by odd?) (take 2)) [1 3 2 4 5 7]))
      "the input that ended the second partition is not flushed as a third")
  (is (= [[1 3]] (into [] (comp (partition-by odd?) (take 1)) [1 3 2 4]))))

(deftest test-partition-by-transducer-state-is-per-transduction
  (let [xf (partition-by odd?)]
    (is (= [[1 3] [2]] (into [] xf [1 3 2])))
    (is (= [[4] [5]] (into [] xf [4 5])) "no leftover buffer or prior value")))

(deftest test-partition-all-transducer
  (is (= [[1 2] [3]] (into [] (partition-all 2) [1 2 3])))
  (is (= [[1 2] [3]] (sequence (partition-all 2) [1 2 3])))
  (is (= [[1 2] [3]] (transduce (partition-all 2) conj [1 2 3]))
      "transduce flushes the buffered tail")
  (is (= [[1 2] [3 4]] (into [] (partition-all 2) [1 2 3 4])))
  (is (= [] (into [] (partition-all 2) []))))

(deftest test-partition-all-transducer-stops-early
  (is (= [[1 2]] (into [] (comp (partition-all 2) (take 1)) [1 2 3 4 5])))
  (is (= [[1 2] [3]] (into [] (comp (partition-all 2) (take 5)) [1 2 3]))))

(deftest test-partition-all-transducer-state-is-per-transduction
  (let [xf (partition-all 2)]
    (is (= [[1 2] [3]] (into [] xf [1 2 3])))
    (is (= [[4 5]] (into [] xf [4 5])) "the first run's tail does not leak")))

(deftest test-partition-all-transducer-rejects-a-non-positive-size
  (is (thrown? \InvalidArgumentException (partition-all 0)))
  (is (thrown? \InvalidArgumentException (partition-all -1)))
  (is (thrown? \InvalidArgumentException (partition-all 1.5))))

(deftest test-replace
  (is (= [:a 2 :a] (replace {1 :a} [1 2 1])))
  (is (vector? (replace {1 :a} [1 2 1])) "a vector in gives a vector out")
  (is (= '(:a 2) (replace {1 :a} '(1 2))))
  (is (not (vector? (replace {1 :a} '(1 2)))) "any other coll gives a lazy seq")
  (is (= [:zero :one 2] (replace [:zero :one] [0 1 2])) "a vector smap maps an index")
  (is (= [nil 2] (replace {1 nil} [1 2])) "a nil value still replaces")
  (is (= [1 2] (replace {} [1 2])))
  (is (= [1 2] (replace nil [1 2])))
  (is (= '() (replace {1 :a} nil))))

(deftest test-replace-is-lazy
  (is (= '(:a 2 :a) (take 3 (replace {1 :a} (cycle [1 2]))))))

(deftest test-replace-transducer
  (is (= [:a 2] (into [] (replace {1 :a}) [1 2])))
  (is (= [:a 2] (sequence (replace {1 :a}) [1 2]))))

(deftest test-replace-transducer-stops-early
  (is (= [:a] (into [] (comp (replace {1 :a}) (take 1)) [1 2 3]))))

(deftest test-replace-transducer-state-is-per-transduction
  (let [xf (replace {1 :a})]
    (is (= [:a 2] (into [] xf [1 2])))
    (is (= [3 :a] (into [] xf [3 1])))))
