(ns phel-bench.core
  (:require phel.bench :refer [defbench]))

;; Core functions benchmarked as Phel, through a real call site.
;;
;; This is the other half of `tests/php/Benchmark/Phel/`. Those classes resolve
;; a core function out of the registry and call it as a PHP callable, which
;; measures the function but bypasses everything the compiler does to a call
;; site: arity selection, type-driven inlining, keyword hoisting. These
;; benchmarks are compiled Phel, so what they measure is what user code pays.
;;
;; The two disagree on purpose. When a PHP subject stays flat and the Phel one
;; moves, the change is in the emitter rather than in `phel.core`.

(def- ints [3 1 4 1 5 9 2 6 5 3 5 8 9 7 9 3 2 3 8 4 6 2 6 4 3 3 8 3 2 7 9 5])

(def- strings ["k3" "k1" "k4" "k1" "k5" "k9" "k2" "k6" "k5" "k3" "k8" "k7"])

(def- nested {:a {:b {:c 42}}})

(defbench bench-sort-ints
  {:revs 200}
  (sort ints))

(defbench bench-sort-strings
  {:revs 200}
  (sort strings))

(defbench bench-reduce-sum
  {:revs 200}
  (reduce + 0 ints))

(defbench bench-for-collect
  {:revs 200}
  (for [x :in ints] (inc x)))

(defbench bench-for-reduce
  {:revs 200}
  (for [x :in ints :reduce [acc 0]] (+ acc x)))

(defbench bench-into-vector
  {:revs 200}
  (into [] ints))

(defbench bench-get-in
  (get-in nested [:a :b :c]))

;; A six-entry map built by growing, which is where the representation a map
;; ends up with is decided (#3172). `bench-get-in` reads two-entry maps and
;; never reaches that size.
(def- grown-map (zipmap [:k0 :k1 :k2 :k3 :k4 :k5] [0 1 2 3 4 5]))

(defbench bench-get-grown-map
  (get grown-map :k5))

(defbench bench-str-three
  (str "a" "b" "c"))

;; Reading a global, which every resolved symbol in compiled Phel does through
;; `\Phel::getDefinition` (#3179). Four reads per rev so the read dominates the
;; arithmetic around it; `def-` rather than a local, because a local is a plain
;; PHP variable and would measure nothing.
(def- answer 42)

(defbench bench-global-var-read
  {:revs 1000}
  (+ answer answer answer answer))

(defbench bench-hash-set-three
  (hash-set :a :b :c))

;; Mapping and filtering four maps into a vector, spelled the eager way and the
;; transducer way (#3323). `filterv` over `mapv` is the baseline the transducer
;; subjects are read against; each of them builds its pipeline inside the rev,
;; as user code writing `(into [] (comp ...) coll)` inline does.
(def- entities [{:hp 3 :alive true} {:hp 1 :alive false}
                {:hp 5 :alive true} {:hp 2 :alive true}])

(defn- heal [e] (assoc e :hp (inc (get e :hp))))

(defbench bench-filterv-mapv
  {:revs 1000}
  (filterv :alive (mapv heal entities)))

(defbench bench-into-map-xform
  {:revs 1000}
  (into [] (map heal) entities))

(defbench bench-into-comp-xform
  {:revs 1000}
  (into [] (comp (map heal) (filter :alive)) entities))

(defbench bench-transduce-conj
  {:revs 1000}
  (transduce (comp (map heal) (filter :alive)) conj [] entities))
