--PHEL--
(ns user (:use DateTimeImmutable :as Moment))
(fn [^Moment d] d)
--PHP--
namespace user;
require_once __DIR__ . '/phel/core.php';
\Phel::addDefinition(
  "phel.core",
  "*file*",
  "Call/tag-use-alias.test"
);
\Phel::addDefinition(
  "phel.core",
  "*ns*",
  "user"
);
(function(\DateTimeImmutable $d): \DateTimeImmutable {
  return $d;
});
