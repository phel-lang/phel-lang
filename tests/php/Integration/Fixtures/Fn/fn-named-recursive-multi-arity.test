--PHEL--
(fn myf ([x] (myf x x)) ([x y] y))
--PHP--
new class() extends \Phel\Lang\AbstractFn {
  public const BOUND_TO = "";

  public function __invoke($a0 = null, $a1 = null, ...$rest) {
    return match (\func_num_args()) {
      1 => $this->invokeArity1($a0),
      2 => $this->invokeArity2($a0, $a1),
      default => throw new \InvalidArgumentException("No matching function arity"),
    };
  }

  public function invokeArity1($x): mixed {
    $myf = $this;
    return ($myf)($x, $x);
  }

  public function invokeArity2($x, $y): mixed {
    $myf = $this;
    return $y;
  }
};
