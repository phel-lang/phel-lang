<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xi="http://www.w3.org/2001/XInclude"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>

    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
        <!-- Types `getFacade()`/`getFactory()`/`getConfig()` from the
             `#[ServiceMap]` attribute (gacela 2.0). Registered here rather than
             through the XInclude, which replaces one element and cannot reach
             `<plugins>`. -->
        <!-- `<moduleRules>` reads the same `module-rules.json` the PHPStan
             `DeclaredModuleDependencyRule` reads, so the declared module
             boundaries mean one thing in both analysers. `sharedNamespace`
             entries must match the `sharedNamespaces` list in `phpstan.neon`.
             Omitting the element turns the check off silently, which is why it
             is here and not left to a default. -->
        <pluginClass class="Gacela\Psalm\Plugin">
            <moduleRules rootNamespace="Phel" file="module-rules.json" modulePathSegments="1">
                <sharedNamespace>Phel\Shared</sharedNamespace>
                <sharedNamespace>Phel\Lang</sharedNamespace>
                <sharedNamespace>Phel\Config</sharedNamespace>
            </moduleRules>
        </pluginClass>
    </plugins>

    <!-- psalm-gacela.xml is still deliberately NOT included. All it does is
         suppress UndefinedMagicMethod for those three accessors, leaving their
         return type as `mixed`. The plugin above resolves them instead. Every
         class using `ServiceResolverAwareTrait` also declares them with
         `@method`, for IDE completion; keep both. -->

    <issueHandlers>
        <!-- Suppress overly strict checks -->
        <MissingOverrideAttribute errorLevel="suppress" />
        <ClassMustBeFinal errorLevel="suppress" />
        <MissingTemplateParam errorLevel="suppress" />
        <ArgumentTypeCoercion errorLevel="suppress" />
        <LessSpecificReturnStatement errorLevel="suppress" />
        <MoreSpecificReturnType errorLevel="suppress" />
        <RiskyTruthyFalsyComparison errorLevel="suppress" />
        <PossiblyUndefinedMethod errorLevel="suppress" />
        <InvalidArrayOffset errorLevel="suppress" />
        <NamedArgumentNotAllowed errorLevel="suppress" />
        <!-- phpstan annotates Fiber<TStart, TResume, TReturn, TSuspend>
             via the bundled stubs; psalm core has no such generics, so
             the annotation reads as four extra params here. Generics are
             accurate for phpstan, suppressed for psalm. -->
        <TooManyTemplateParams errorLevel="suppress" />
        <!-- Subclass-narrowed PHPDoc returns required by phpstan's
             missingType.generics rule (e.g. AbstractAtomNode<mixed>);
             psalm sees concrete subclasses and reports a mismatch. -->
        <InvalidReturnStatement errorLevel="suppress" />
        <InvalidReturnType errorLevel="suppress" />
        <ImplementedReturnTypeMismatch errorLevel="suppress" />
        <MoreSpecificImplementedParamType errorLevel="suppress" />
        <RedundantCastGivenDocblockType errorLevel="suppress" />

        <!-- Gacela architecture rules, added to psalm in 2.1.0. Every finding
             below is a decision already argued site by site in `phpstan.neon`,
             which has run the same three rules since 2.0; these entries mirror
             it so the two analysers agree rather than restating the reasoning.
             Read `phpstan.neon` for the why before changing anything here.

             One difference is structural and worth knowing: phpstan pins each
             path with a `count`, so a genuinely new offender makes a count
             short by one and gets reported. Psalm has no count, so these are
             blanket per-file suppressions and phpstan keeps sole ownership of
             the drift detection. Add a path here only after pinning its count
             there. -->
        <PluginIssue name="GacelaFacadeInterfaceDrift">
            <errorLevel type="suppress">
                <file name="src/php/Api/ApiFacade.php" />
                <file name="src/php/Build/BuildFacade.php" />
                <file name="src/php/Compiler/CompilerFacade.php" />
                <file name="src/php/Interop/InteropFacade.php" />
                <file name="src/php/Run/RunFacade.php" />
            </errorLevel>
        </PluginIssue>
        <PluginIssue name="GacelaFacadeOnlyDelegates">
            <errorLevel type="suppress">
                <file name="src/php/Build/BuildFacade.php" />
            </errorLevel>
        </PluginIssue>
        <PluginIssue name="GacelaSuffixExtends">
            <errorLevel type="suppress">
                <file name="src/php/Compiler/Domain/Analyzer/SymbolSuggestionProvider.php" />
                <file name="src/php/Compiler/Domain/Emitter/OutputEmitter/NodeEmitterFactory.php" />
                <file name="src/php/Compiler/Domain/Parser/ExpressionParserFactory.php" />
                <file name="src/php/Compiler/Domain/Reader/ExpressionReaderFactory.php" />
                <file name="src/php/Config/PhelBuildConfig.php" />
                <file name="src/php/Config/PhelConfig.php" />
                <file name="src/php/Config/PhelExportConfig.php" />
                <file name="src/php/Lang/Collections/LazySeq/LazySeqConfig.php" />
                <!-- Not in phpstan's list, which does not flag it. `Lang` is a
                     leaf with no Gacela pillars at all (`src/php/CLAUDE.md`), so
                     this is the same category as the rest: a runtime type whose
                     suffix collides with a pillar name. The two lists are not
                     meant to match line for line; each analyser is pinned
                     against what it actually reports. -->
                <file name="src/php/Lang/TypeFactory.php" />
            </errorLevel>
        </PluginIssue>

        <!-- Mixed* handlers: what stays global and why.

             A Phel value is an open set (interop admits arbitrary PHP objects,
             arrays and resources), so `mixed` is the honest type across Lang's
             collections, the printers and the analyzer's special forms.

             The other former source of noise was psalm-gacela: it only
             suppresses UndefinedMagicMethod for `getFacade()`/`getFactory()`/
             `getConfig()` and never resolves their return types, so a facade
             call read as `mixed` and cascaded through the whole command. That
             is fixed at the source rather than here: every class using
             `ServiceResolverAwareTrait` now declares those methods with
             `@method`, next to the `#[ServiceMap]` attribute that already
             names the class. Do not drop those annotations.

             Measured with all twelve handlers enabled (psalm 6.16, no cache):
             646 errors before the annotations, 478 after. The remainder is the
             interop boundary itself, so the high-volume handlers stay global;
             phpstan level 9 covers explicit `mixed` misuse instead.

             ENABLED, so new leaks are caught: MixedFunctionCall,
             MixedArrayAssignment (never had an occurrence), MixedOperand and
             MixedMethodCall (both went to zero), plus MixedArrayAccess and
             MixedArrayOffset with the file exceptions listed below. Each file
             listed is an irreducible position, not a to-do. -->
        <MixedArgument errorLevel="suppress" />
        <MixedArgumentTypeCoercion errorLevel="suppress" />
        <MixedAssignment errorLevel="suppress" />
        <MixedPropertyTypeCoercion errorLevel="suppress" />
        <MixedReturnStatement errorLevel="suppress" />
        <MixedReturnTypeCoercion errorLevel="suppress" />

        <MixedArrayAccess>
            <errorLevel type="suppress">
                <!-- Structural `toArray()` duck-typing: the value set is open by design. -->
                <file name="src/php/Lang/Collections/Vector/AbstractPersistentVector.php" />
            </errorLevel>
        </MixedArrayAccess>
        <MixedArrayOffset>
            <errorLevel type="suppress">
                <!-- Property keys are `string` by declaration; psalm loses them
                     across the `walk()` call that fills the property. -->
                <file name="src/php/Compiler/Domain/Analyzer/TypeAnalyzer/SpecialForm/ParamTypeInferrer.php" />
                <!-- Symfony's `Command::getAliases(): array` carries no value type. -->
                <file name="src/php/Console/Infrastructure/Command/LazyCommandLoader.php" />
            </errorLevel>
        </MixedArrayOffset>
    </issueHandlers>
</psalm>
