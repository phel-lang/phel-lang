includes:
    - vendor/gacela-project/gacela/phpstan-gacela.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

services:
    # Modules may only reach each other through a Facade. `.claude/rules/php.md`
    # has said so for a long time; until now only hand-rolled architecture tests
    # enforced parts of it, and they check Factories, not Application classes.
    #
    # `Phel\Shared`, `Phel\Lang` and `Phel\Config` are shared kernels: they are
    # the namespaces every module is *supposed* to reach into (the values that
    # cross a facade boundary, the contracts facades speak in, and the config
    # object). See docs/stability.md.
    -
        class: Gacela\PHPStan\Rules\CrossModuleViaFacadeRule
        tags: [phpstan.rules.rule]
        arguments:
            rootNamespace: Phel
            modulePathSegments: 1
            sharedNamespaces:
                - Phel\Shared
                - Phel\Lang
                - Phel\Config

    # Which module may reach which, from `module-rules.json`. Until now that
    # decision lived only in prose: `Console/CLAUDE.md` says nothing may import
    # Console, `Filesystem/CLAUDE.md` and `Fiber/CLAUDE.md` call themselves
    # leaves. Prose cannot see a new import in a diff. Every rule in the file is
    # one of those sentences, and each one held when it was added.
    #
    # `sharedNamespaces` must stay identical to the list above. It exempts the
    # namespaces Gacela's CLI graph cannot see at all (Lang, Shared and Config
    # have no Gacela pillars), which is what makes one file mean the same thing
    # to `debug:graph --check --rules` and to the analysers.
    #
    # GOTCHA: phpstan's result cache is not keyed on `module-rules.json`, so
    # editing the file alone will not re-analyse, and a cached finding keeps the
    # `reason` string it was written with. `--clear-cache` does NOT help, it
    # clears a different cache; run `phpstan clear-result-cache`. Verified by
    # watching a stale reason survive `--clear-cache` and disappear only after
    # the result cache went. CI always starts cold, so this bites locally only.
    -
        class: Gacela\PHPStan\Rules\DeclaredModuleDependencyRule
        tags: [phpstan.rules.rule]
        arguments:
            rootNamespace: Phel
            rulesFile: %currentWorkingDirectory%/module-rules.json
            modulePathSegments: 1
            sharedNamespaces:
                - Phel\Shared
                - Phel\Lang
                - Phel\Config

    # Every pillar accessor carries `#[ServiceMap]` (the `@method` docblock stays
    # for IDEs); the docblock fallback is what gacela 3.0 removes, so a class
    # that forgets the attribute fails here rather than at the upgrade.
    -
        class: Gacela\PHPStan\Rules\ServiceMapMissingRule
        tags: [phpstan.rules.rule]

    # The other half of the check above (gacela 2.4): a boundary crossed
    # through a *typed receiver* rather than a name written at the call site,
    # which is how it happens once dependencies arrive through Providers. The
    # five receivers below are what `CompilerFacadeInterface` itself hands
    # back (`getGlobalEnvironment()`, `emptyNodeEnvironment()`, `read()`,
    # `compile*()`, `analyze()`), so calling a method on them is using the
    # facade's answer, not reaching past the facade. Anything else from another
    # module's `Domain`/`Application` is reported.
    -
        class: Gacela\PHPStan\Rules\CrossModuleMethodCallRule
        tags: [phpstan.rules.rule]
        arguments:
            rootNamespace: Phel
            modulePathSegments: 1
            sharedNamespaces:
                - Phel\Shared
                - Phel\Lang
                - Phel\Config
            ignoreReceivers:
                - Phel\Compiler\Domain\Analyzer\Environment\GlobalEnvironmentInterface
                - Phel\Compiler\Domain\Analyzer\Environment\NodeEnvironmentInterface
                - Phel\Compiler\Domain\Analyzer\Ast\AbstractNode
                - Phel\Compiler\Domain\Parser\ReadModel\ReaderResult
                - Phel\Compiler\Domain\Emitter\EmitterResult

parameters:
    level: 9
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 3000.0
    paths:
        - %currentWorkingDirectory%/src/
    # `!` discards the ignoreErrors merged in from phpstan-gacela.neon, which
    # silences "Call to an undefined method ::getFacade/getFactory/getConfig".
    # Every class using ServiceResolverAwareTrait declares those methods with
    # `@method`, so the pattern never matches here and a new class that forgets
    # the annotation should fail rather than resolve to `mixed`.
    ignoreErrors!:
        # --- gacela.crossModuleWithoutFacade -------------------------------
        # Pinned, not waived. Counts are the point: a new cross-module reach
        # makes a count short by one and that one is reported.
        #
        # 1. The console is the composition root. Registering every module's
        #    commands is the one job it has, so naming their classes is not a
        #    boundary violation. 28 of the 39 (`MutateCommands` adds two, #3208).
        -
            identifier: gacela.crossModuleWithoutFacade
            path: src/php/Console/Infrastructure/Command/*Commands.php
            count: 28
        # 2. `FilesystemFacadeInterface` lives in `Phel\Filesystem\` while every
        #    other cross-module facade contract lives in `Phel\Shared\Facade\`.
        #    Referencing it *is* going through a facade, and since gacela 2.4
        #    the interface says so itself with `#[PublicApi]`, so the six
        #    Factory/Provider references are no longer pinned here. Moving it
        #    to Shared is still a BREAKING change to the surface frozen in
        #    #2870 and waits for the next major.
        # 3. Genuine reaches into another module's `Domain`, which the rule is
        #    exactly right about. Each is one class and each is worth fixing on
        #    its own; pinned individually so a fix removes its own entry rather
        #    than shrinking an anonymous total.
        -
            identifier: gacela.crossModuleWithoutFacade
            path: src/php/Run/Application/FileRunner.php
            count: 1
        - identifier: trait.unused
        # A `Shared\Facade\*FacadeInterface` is the *cross-module* contract, not
        # a mirror of the facade. `Shared/CLAUDE.md` says to keep its imports
        # minimal, and every method below is called only from inside its own
        # module (its own `Infrastructure/Command/`, or emitted PHP for the
        # BuildMode trio and the `*loading-dependencies*` trio #3015 added
        # alongside it), so no consumer type-hinting the interface is missing
        # anything. Declaring them would drag `BuildOptions`, `ApiDaemon`,
        # `CoverageDriver`, `CoverageReport`, `ParallelTestOrchestrator` and
        # `CpuCountDetector` into the leaf layer and widen the public surface
        # 1.0 has to freeze, for no caller's benefit.
        #
        # The counts are the point: a genuinely new cross-module method that
        # skips the interface makes the count short by one and that one is
        # reported. Re-count deliberately, never just to get back to green.
        #
        # `reportUnmatched` is left at its default: `FacadeInterfaceInSyncRule`
        # ships in 2.0, so an entry that stops matching means the drift it
        # covered was fixed, and the pin should go with it rather than linger.
        -
            identifier: gacela.facadeInterfaceDrift
            path: src/php/Api/ApiFacade.php
            count: 1
        -
            identifier: gacela.facadeInterfaceDrift
            path: src/php/Build/BuildFacade.php
            # The BuildMode trio and the three `*loading-dependencies*` statics
            # (#3015) are emitted into compiled PHP by NsEmitter / LoadEmitter,
            # so they are public static and cannot go on the cross-module
            # contract; gacela 2.4 no longer counts static methods for either
            # `facadeOnlyDelegates` or `facadeInterfaceDrift`, which is why the
            # count dropped from 11 to 5 with no interface change.
            count: 5
        -
            identifier: gacela.facadeInterfaceDrift
            path: src/php/Compiler/CompilerFacade.php
            count: 1
        -
            identifier: gacela.facadeInterfaceDrift
            path: src/php/Interop/InteropFacade.php
            count: 2
        -
            identifier: gacela.facadeInterfaceDrift
            path: src/php/Run/RunFacade.php
            # 7 + `buildPerTestCoverageReport()` (#3207) + `selectChangedTests()`
            # (#3210): like the other coverage methods they return Run-internal
            # types, which the Shared contract must not name.
            count: 9
        # LazySeq::cdr() checks instanceof SeqInterface for runtime safety
        # even though PHPDoc inference says the type is already narrowed.
        -
            identifier: instanceof.alwaysTrue
            path: src/php/Lang/Collections/LazySeq/LazySeq.php
        # Phel-domain classes whose suffix coincides with Gacela pillar names
        # but are not Gacela modules (they're plain Phel runtime/config types).
        -
            identifier: gacela.suffixExtends
            paths:
                - src/php/Compiler/Domain/Analyzer/SymbolSuggestionProvider.php
                - src/php/Compiler/Domain/Emitter/OutputEmitter/NodeEmitterFactory.php
                - src/php/Compiler/Domain/Parser/ExpressionParserFactory.php
                - src/php/Compiler/Domain/Reader/ExpressionReaderFactory.php
                - src/php/Config/PhelBuildConfig.php
                - src/php/Config/PhelConfig.php
                - src/php/Config/PhelExportConfig.php
                - src/php/Lang/Collections/LazySeq/LazySeqConfig.php
                - src/php/Lang/TypeFactory.php
        # Printer's dispatchers select a TypePrinterInterface<Concrete> per
        # runtime-matched type, which is sound by construction but an
        # existential type: generic invariance cannot relate it to the
        # declared TypePrinterInterface<mixed> return.
        -
            identifier: return.type
            path: src/php/Shared/Printer/Printer.php
        # ReflectionType::__toString() is the correct replacement for deprecated
        # (string) casts, but PHP 8.5's phpstan flags the explicit call too while
        # 8.4 does not. reportUnmatched keeps both runtimes green during the
        # transition (mirrors while.alwaysTrue above).
        -
            identifier: class.toStringDeprecated
            path: src/php/Api/Application/PhpInteropReflector.php
            reportUnmatched: false
        -
            identifier: class.toStringDeprecated
            path: src/php/Interop/Domain/Generator/Builder/CompiledPhpMethodBuilder.php
            reportUnmatched: false
