(in-ns phel.core)

;; Safe string → primitive parsers: `parse-long`, `parse-double`,
;; `parse-boolean`. Each returns `nil` on invalid input instead of
;; throwing, so callers can chain them in `when`/`if-let` without
;; guarding against exceptions.

;; --- Safe parsing ---

(defn parse-long
  "Parses a string as an integer. Returns nil if parsing fails or the number does not fit in a 64-bit int."
  {:example "(parse-long \"123\") ; => 123"
   :see-also ["parse-double"]}
  [s]
  (when (string? s)
    (let [trimmed (php/trim s)]
      (when (some? (re-matches "/[+-]?[0-9]+/" trimmed))
        (let [n (php/intval trimmed)]
          ;; `intval` saturates at the int bounds, so a bound result is kept
          ;; only when the digits spell exactly that bound.
          (if (or (php/=== n php/PHP_INT_MAX) (php/=== n php/PHP_INT_MIN))
            (let [negative (php/=== "-" (php/substr trimmed 0 1))
                  digits   (php/ltrim trimmed "+-0")]
              (when (php/=== (php/strval n) (php/. (if negative "-" "") digits))
                n))
            n))))))

(defn parse-double
  "Parses a string as a float. Returns `nil` for non-numeric input or for inputs that are not strings. Accepts `Infinity`, `-Infinity`, and `NaN` alongside regular decimal and scientific notation."
  {:example "(parse-double \"3.14\") ; => 3.14\n(parse-double \"Infinity\") ; => Infinity"
   :see-also ["parse-long"]}
  [s]
  (when (string? s)
    (let [trimmed (php/trim s)]
      (cond
        (or (= trimmed "Infinity") (= trimmed "+Infinity")) php/INF
        (= trimmed "-Infinity")                             (php/- 0 php/INF)
        (= trimmed "NaN")                                   NAN
        (php/is_numeric trimmed)                            (php/floatval trimmed)
        :else                                               nil))))

(defn parse-boolean
  "Parses a string as a boolean. Returns `true` for the exact string
  `\"true\"`, `false` for `\"false\"`, and `nil` for any other input.
  The match is case-sensitive and does not tolerate surrounding
  whitespace."
  {:example "(parse-boolean \"true\") ; => true\n(parse-boolean \"True\") ; => nil"}
  [s]
  (when (string? s)
    (cond
      (= s "true")  true
      (= s "false") false)))
