(in-ns phel.core)

(use Phel)
(use Phel.Lang.Reduced)
(use Phel.Lang.Seq)
(use Phel.Lang.Volatile)

;; Reduce / transduce pipeline plus the volatile reference cells that power
;; transducer state: `reduced`, `reduced?`, `unreduced`, `ensure-reduced`,
;; `reduce`, `completing`, `transduce`, `halt-when`, `volatile!`, `vreset!`,
;; `vswap!`, `volatile?`.
;; Volatiles live here because their main role in Phel is as fast-mutable
;; accumulators inside transducers.

;; -------------------
;; Transducer support
;; -------------------

(defn reduced
  "Wraps `x` in a Reduced, signaling early termination from reduce/transduce."
  {:example "(reduce (fn [acc x] (if (= x 3) (reduced acc) (+ acc x))) 0 [1 2 3 4]) ; => 3"
   :see-also ["reduced?" "unreduced"]}
  [x]
  (new Reduced x))

(defn reduced?
  "Returns true if `x` is a Reduced value."
  {:example "(reduced? (reduced 1)) ; => true"
   :see-also ["reduced" "unreduced"]}
  [x]
  (php/instanceof x Reduced))

(defn unreduced
  "If `x` is Reduced, returns the unwrapped value; otherwise returns `x`."
  {:example "(unreduced (reduced 1)) ; => 1\n(unreduced 1) ; => 1"
   :see-also ["reduced" "reduced?"]}
  [x]
  (if (reduced? x)
    (.deref x)
    x))

(defn ensure-reduced
  "Returns `x` if it is already reduced, otherwise wraps it in `reduced`. Never wraps twice."
  {:example "(reduced? (ensure-reduced 1)) ; => true\n(unreduced (ensure-reduced (reduced 1))) ; => 1"
   :see-also ["reduced" "reduced?" "unreduced"]}
  [x]
  (if (reduced? x) x (reduced x)))

(defn- preserving-reduced
  "Wraps a reducing function so Reduced propagates as double-wrapped."
  [rf]
  (fn [a b]
    (let [ret (rf a b)]
      (if (reduced? ret) (reduced ret) ret))))

(defn reduce
  "Reduces collection to a single value by repeatedly applying function to accumulator and elements. Respects early termination via `(reduced val)`."
  {:example "(reduce + [1 2 3 4]) ; => 10"
   :see-also ["transduce" "into" "reduced"]}
  ;; Real arities rather than `(case (count args) ...)` over a rest argument.
  ;; That spelling paid twice: once for the variadic parameter, once for
  ;; recovering the arguments with `count`, `first` and `second` after the
  ;; caller had already passed them positionally. See #2973.
  ([f coll]
   (let [s (seq coll)]
     ;; Seed from `seq` rather than from `coll` directly: the 3-arity loop
     ;; only needs the collection to be iterable, so the no-init arity must
     ;; not demand more. `first`/`next` reject a plain iterable (an
     ;; `eduction`, a generator), while `seq` normalizes one into a seq that
     ;; both understand, without forcing a lazy sequence.
     (if (nil? s)
       (f)
       (reduce f (first s) (next s)))))
  ([f init coll]
   ;; `reduced?` and `not` spelled as the PHP checks they are. Both run once
   ;; per element, and `reduced?` is `(php/instanceof x Reduced)` behind a
   ;; function call; `done` only ever holds a bool, so the loop guard does not
   ;; need Phel truthiness either (#2973).
   (let [acc  (new Volatile init)
         done (new Volatile false)]
     ;; One `.reset` around the branch rather than one in each arm: the emitter
     ;; wrapped the else arm's `(.reset acc result)` in a closure it built and
     ;; called on every element (#3323).
     (dofor [x :in (Seq/elementsOf coll) :while (php/=== false (.deref done))]
       (let [result (f (.deref acc) x)]
         (.reset acc (if (php/instanceof result Reduced)
                       (do (.reset done true)
                           (.deref result))
                       result))))
     (.deref acc))))

(defn reduce-kv
  "Reduces an associative collection by applying `f` to the accumulator, key and value of each entry, starting with `init`. Vectors use the index as key. Respects early termination via `(reduced val)`."
  {:example "(reduce-kv (fn [m k v] (assoc m v k)) {} {:a 1 :b 2}) ; => {1 :a, 2 :b}"
   :see-also ["reduce" "update-keys" "update-vals" "reduced"]}
  [f init coll]
  (let [acc  (new Volatile init)
        done (new Volatile false)]
    ;; Same two inlines as `reduce` above, for the same per-element reason.
    (dofor [[k v] :pairs coll :while (php/=== false (.deref done))]
      (let [result (f (.deref acc) k v)]
        (if (php/instanceof result Reduced)
          (do (.reset acc (.deref result))
              (.reset done true))
          (.reset acc result))))
    (.deref acc)))

(defn completing
  "Takes a reducing function `f` of 2 args and returns a fn suitable for transduce by adding a 1-arity (completion) that calls `cf` (default: identity)."
  {:example "(transduce (filter even?) (completing conj) [] [1 2 3 4]) ; => [2 4]"
   :see-also ["transduce"]}
  ([f] (completing f identity))
  ([f cf]
   (fn
     ([] (f))
     ([result] (cf result))
     ([result input] (f result input)))))

(defn transduce
  "Reduce with a transformation of `f` (xf). If init is not supplied,
  `(f)` will be called to produce it. `f` should be a reducing function
  that returns the initial value when called with no arguments. The
  result is passed once to `f`'s 1-arity (completion); wrap a 2-arity
  reducer in `completing`."
  {:example "(transduce (map inc) + [1 2 3]) ; => 9"
   :see-also ["reduce" "into" "sequence"]}
  ;; Real arities rather than `(case (count args) ...)` over a rest argument
  ;; (#2973): both spellings are exact, so the rest vector only existed to be
  ;; unpacked again.
  ([xform f coll]
   (transduce xform f (f) coll))
  ([xform f init coll]
   ;; Never wrap `f` in `completing`: its `identity` completion would hide
   ;; `f`'s own 1-arity.
   (let [rf  (xform f)
         ret (reduce rf init coll)]
     (rf ret))))

;; Clojure marks the halted value with a `::halt` map key, which a reduction
;; that never halts could still produce. A private object cannot collide.
(def- halt-when-marker (new \stdClass))

(defn halt-when
  "Returns a transducer that ends the transduction at the first input for which `pred` is truthy. The whole transduction then returns that input, or `(retf (rf result) input)` when `retf` is given. Inputs that do not match pass through unchanged."
  {:example "(transduce (halt-when neg?) conj [] [1 2 -1 3]) ; => -1\n(transduce (halt-when neg? (fn [r x] [r x])) conj [] [1 -1 2]) ; => [[1] -1]\n(into [] (halt-when neg?) [1 2]) ; => [1 2]"
   :see-also ["transduce" "reduced" "take-while"]}
  ([pred] (halt-when pred nil))
  ([pred retf]
   (fn [rf]
     (fn
       ([] (rf))
       ([result]
        (if (and (vector? result) (identical? halt-when-marker (first result)))
          (second result)
          (rf result)))
       ([result input]
        (if (pred input)
          (reduced [halt-when-marker (if retf (retf (rf result) input) input)])
          (rf result input)))))))

(defn volatile!
  "Creates a volatile mutable reference with initial value `val`. Use for transducer state that needs fast mutation without watches."
  {:example "(let [v (volatile! 0)] (vreset! v 5) @v) ; => 5"
   :see-also ["vreset!" "vswap!" "var"]}
  [val]
  (new Volatile val))

(defn vreset!
  "Sets the value of volatile `vol` to `val`. Returns `val`."
  {:example "(let [v (volatile! 0)] (vreset! v 9)) ; => 9"
   :see-also ["volatile!" "vswap!"]}
  [vol val]
  (.reset vol val))

(defn vswap!
  "Applies `f` to the current value of volatile `vol` plus `args`, and sets the new value. Returns the new value."
  {:example "(let [v (volatile! 10)] (vswap! v + 5)) ; => 15"
   :see-also ["volatile!" "vreset!"]}
  [vol f & args]
  (vreset! vol (apply f @vol args)))

(defn volatile?
  "Returns true if `x` is a Volatile."
  {:example "(volatile? (volatile! 0)) ; => true"
   :see-also ["volatile!" "vreset!" "vswap!"]}
  [x]
  (php/instanceof x Volatile))
