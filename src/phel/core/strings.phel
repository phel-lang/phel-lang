(in-ns phel.core)

(use Phel.Shared.Munge)
(use Phel.Lang.PhelVar)
(use Phel.Lang.Symbol)

(def ^:private symbol-munge
  ;; Munge is a final readonly class; reuse one instance to decode var
  ;; namespaces back to their display form when constructing symbols.
  (new Munge))

;; Two families of primitive value constructors grouped together:
;;   - Symbol constructors: `symbol` (a runtime symbol from a string or
;;     namespace+name pair) and `gensym` (a fresh unique symbol, used by
;;     macros to avoid capture).
;;   - String conversion: `str` (concatenate any number of values into a
;;     string) plus its private helpers `float-to-str` and `val-to-str`.
;;     Handles nil → "", booleans → "true"/"false", integer-valued floats
;;     keeping the trailing `.0`.

(defn- to-symbol-part
  "Extracts the underlying string from `x` for use as a symbol or namespace component. Keywords and symbols pass through their `name`."
  [x]
  (if (php/=== nil x)
    nil
    (if (php/instanceof x Phel.Lang.NamedInterface)
      (.getName x)
      x)))

(defn- valid-symbol-name? [x]
  (if (php/is_string x)
    true
    (if (php/instanceof x Phel.Lang.Keyword)
      true
      (php/instanceof x Phel.Lang.Symbol))))

(defn- assert-symbol-name [arg-name x]
  (if (valid-symbol-name? x)
    nil
    (throw (new InvalidArgumentException
                (php/. "symbol expects a string, keyword, or symbol for "
                       arg-name
                       ", got "
                       (php/get_debug_type x))))))

(defn symbol
  "Returns a new symbol for the given name with an optional namespace.

With one argument, creates a symbol without namespace. Accepts a string, a keyword, another symbol, or a `Var` (in which case the result is a fully qualified symbol naming the var). With two arguments, creates a symbol in the given namespace; a `nil` namespace yields a symbol without a namespace.

Throws `InvalidArgumentException` for any other input (including functions, numbers, and collections)."
  {:example "(symbol \"foo\") ; => foo\n(symbol :abc) ; => abc\n(symbol nil \"foo\") ; => foo\n(symbol #'phel.core/+) ; => phel.core/+"}
  ;; Fixed arities rather than `[name-or-ns & [name]]`, which allocated a rest
  ;; argument and then destructured a single value back out of it: the costliest
  ;; of the variadic shapes measured in #2973. The variadic tail is kept only so
  ;; that a third argument goes on being ignored rather than becoming an arity
  ;; error, which would be a source-compatibility break and is a decision for
  ;; its own change, not for a speedup.
  ([name-or-ns]
   (if (php/instanceof name-or-ns Symbol)
     name-or-ns
     (if (php/instanceof name-or-ns PhelVar)
       (Symbol/createForNamespace
        (.decodeNs symbol-munge (.getNamespace name-or-ns))
        (.getName name-or-ns))
       (do
         (assert-symbol-name "name-or-ns" name-or-ns)
         (Symbol/create (to-symbol-part name-or-ns))))))
  ([name-or-ns name]
   ;; `(symbol ns nil)` still means "no name", as it did when `name` simply
   ;; failed to arrive.
   (if name
     (do
       (assert-symbol-name "name" name)
       (if (php/=== nil name-or-ns)
         (Symbol/create (to-symbol-part name))
         (do
           (assert-symbol-name "namespace" name-or-ns)
           (Symbol/createForNamespace
            (to-symbol-part name-or-ns)
            (to-symbol-part name)))))
     (symbol name-or-ns)))
  ([name-or-ns name & ignored] (symbol name-or-ns name)))

(defn gensym
  "Generates a new unique symbol."
  {:example "(gensym) ; => __phel_1"
   :see-also ["symbol"]}
  []
  (Symbol/gen))

(defn- float-to-str
  "Renders a float so integer-valued floats keep the trailing `.0`, while `NaN` and ±Infinity stringify readably."
  [x]
  (if (php/is_nan x)
    "NaN"
    (if (php/is_infinite x)
      (if (php/> x 0) "Infinity" "-Infinity")
      (let [s (php/. "" x)]
        ;; `strpbrk` answers "does it already read as a float" in one scan; a
        ;; regex would compile a pattern to look for three characters. Keep
        ;; the native call: phel.string has no character-set search equivalent.
        (if (php/strpbrk s ".eE")
          s
          (php/. s ".0"))))))

(defn- val-to-str
  "Converts a value to its string representation. Booleans become \"true\" or \"false\". Nil becomes an empty string. Integer-valued floats keep their `.0` suffix (so `(str 0.0)` is `\"0.0\"`, not `\"0\"`). All other values use PHP string cast."
  [x]
  (if (php/=== x true)      "true"
      (if (php/=== x false)   "false"
          (if (php/=== x nil)   ""
              (if (php/is_float x) (float-to-str x)
                  (php/. "" x))))))

(defn str
  "Creates a string by concatenating values together. If no arguments are provided an empty string is returned. Nil is represented as an empty string. Booleans are represented as \"true\" or \"false\" (matching Clojure semantics). Otherwise, it tries to call `__toString`."
  {:example "(str \"a\" \"b\" \"c\") ; => \"abc\"\n(str 1 2 3) ; => \"123\"\n(str 1 nil true) ; => \"1true\"\n(str) ; => \"\""
   :see-also ["print-str" "pr-str" "format"]}
  ;; Fixed arities for the counts that actually occur. `str` is the most used
  ;; variadic in core, and on the variadic form even `(str a b)` allocated a
  ;; rest argument, built an intermediate array, pushed into it and called
  ;; `implode`. The concatenation was never the cost. See #2973.
  ;;
  ;; Four and five are here because the cliff is steep and they are common.
  ;; `bench_str_four` went from 42.4μs to 10.9μs and `bench_str_five` from
  ;; 51.8μs to 12.7μs, while `bench_str_three` did not move. Across `src/phel`
  ;; there are 29 call sites at four arguments and 20 at five, against 18 at
  ;; six or more, which still take the loop below.
  ;;
  ;; A call whose arguments are string-typed never arrives here at all:
  ;; `CoreFnCallEmitter::tryEmitStrConcat` lowers it to native `.`. This is the
  ;; untagged path, which is what a value from a parameter or a global reaches.
  (^string [] "")
  (^string [x] (val-to-str x))
  (^string [x y] (php/. (val-to-str x) (val-to-str y)))
  (^string [x y z] (php/. (val-to-str x) (val-to-str y) (val-to-str z)))
  (^string [x y z a] (php/. (val-to-str x) (val-to-str y) (val-to-str z) (val-to-str a)))
  (^string [x y z a b]
   (php/. (val-to-str x) (val-to-str y) (val-to-str z) (val-to-str a) (val-to-str b)))
  (^string [x y z a b & more]
   ;; Bootstrap: `php-indexed-array` is defined after `str`.
   (let [parts (php/array)
         cnt   (php/count more)]
     (php/apush parts (val-to-str x))
     (php/apush parts (val-to-str y))
     (php/apush parts (val-to-str z))
     (php/apush parts (val-to-str a))
     (php/apush parts (val-to-str b))
     (loop [i 0]
       (if (php/< i cnt)
         (do (php/apush parts (val-to-str (php/aget more i)))
             (recur (php/+ i 1)))
         (php/implode "" parts))))))
