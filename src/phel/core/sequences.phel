(in-ns phel.core)

(use InvalidArgumentException)
(use OutOfBoundsException)
(use Phel.Lang.Collections.HashSet.PersistentHashSetInterface)
(use Phel.Lang.Collections.HashSet.TransientHashSetInterface)
(use Phel.Lang.Collections.LazySeq.LazySeqInterface)
(use Phel.Lang.Collections.Map.MapEntry)
(use Phel.Lang.Collections.Map.PersistentMapInterface)
(use Phel.Lang.Collections.Map.TransientMapInterface)
(use Phel.Lang.Collections.Queue.PersistentQueue)
(use Phel.Lang.Collections.Vector.PersistentVectorInterface)
(use Phel.Lang.Collections.Vector.TransientVectorInterface)
(use Phel.Lang.NumericOperations)
(use Phel.Lang.PopInterface)

;; Indexed / associative access primitives used as building blocks by the
;; higher-level seq API back in core.phel: `peek`, `push`, `pop`, `get`,
;; `nth`, `nthrest`, `nthnext`, `assoc`, `put`, `dissoc`, `unset`.
;; Loaded mid-core because the later `map`/`filter`/`reduce` definitions
;; depend on them.

;; ------------------
;; Sequence operation
;; ------------------

(defn peek
  "Returns the head of a vector / PHP array (the last element) or the head of a list / lazy sequence / queue (the first element). Returns nil if `coll` is empty or nil."
  {:example "(peek [1 2 3]) ; => 3\n(peek '(:a :b :c)) ; => :a"}
  [coll]
  (cond
    (nil? coll)
    nil

    (list? coll)
    (first coll)

    (php/instanceof coll LazySeqInterface)
    (first coll)

    (php/instanceof coll PersistentQueue)
    (first coll)

    :else
    (let [n (count coll)]
      (if (php/=== 0 n)
        nil
        (aget coll (php/- n 1))))))

(defn- pop*
  "Removes the last element of `coll`. Returns nil for nil or empty PHP arrays."
  [^:by-ref coll]
  (cond
    (nil? coll) nil
    (php-array? coll) (php/array_pop coll)
    (php/instanceof coll PopInterface) (.pop coll)
    (throw (new InvalidArgumentException "Cannot pop"))))

(defmacro pop
  "Removes the last element of a collection. Returns nil for nil."
  {:example "(pop [1 2 3]) ; => [1 2]"
   :see-also ["conj" "rest"]}
  [coll]
  (if (symbol? coll)
    `(pop* ~coll)
    (let [coll-sym (gensym)]
      `(let [~coll-sym ~coll]
         (pop* ~coll-sym)))))

(defn- transient-vector?
  [coll]
  (php/instanceof coll TransientVectorInterface))

(defn- indexed-vector?
  [coll]
  ;; Strict: persistent or transient `PersistentVectorInterface`. `MapEntry`
  ;; is a vector to `vector?` callers but does not support `aget`, so
  ;; `nth`/`get` must keep walking to their seq fallbacks for it.
  (or (php/instanceof coll PersistentVectorInterface)
      (transient-vector? coll)))

(defn- in-bounds?
  [index size]
  (and (php/>= index 0) (php/< index size)))

(defn get
  "Gets the value at key in a collection. Returns default if not found."
  {:example "(get {:a 1} :a) ; => 1"}
  ;; Fixed arities rather than `& [opt]`: the two-argument call is nearly every
  ;; call, and the variadic form made each one allocate and destructure a rest
  ;; argument before the dispatch below even started.
  ;;
  ;; The `(let [res (php/aget ds k)] ...)` shape below repeats rather than
  ;; being lifted into a helper, and reads through `php/aget` rather than core
  ;; `aget`. Either would put a function call back on the path this ordering
  ;; exists to shorten; core `aget`'s two-argument arity is that exact `php/aget`.
  ;;
  ;; The two-argument call answers maps and vectors without delegating to the
  ;; three-argument arity at all. With no default, `opt` is nil and `php/aget`
  ;; already answers nil for an absent key, so the whole `(if (nil? res) opt
  ;; res)` dance collapses to the read itself. That removes two of the three
  ;; Phel function calls a `(get m k)` used to make.
  ([ds k]
   (cond
     (php/instanceof ds PersistentMapInterface)
     (php/aget ds k)

     (php/instanceof ds PersistentVectorInterface)
     (if (integer? k) (php/aget ds k) nil)

     ;; Transient maps too. `group-by`, `frequencies`, `into` a map and every
     ;; other `for :reduce` that accumulates into one read a key per element,
     ;; and without this they fall past both branches above into the
     ;; three-argument arity to be tested a third time.
     (php/instanceof ds TransientMapInterface)
     (php/aget ds k)

     :else
     (get ds k nil)))
  ([ds k opt]
   (cond
     ;; Maps and structs first. They were reached last, behind `nil?`,
     ;; `indexed?`, `set?`, `seq?` and `indexed-vector?`, five helper calls to
     ;; land on the most common target. `indexed?` excludes maps and a struct is
     ;; a PersistentMapInterface, so both arrive here with the same answer the
     ;; `:else` branch gave them, from the same `aget`.
     (php/instanceof ds PersistentMapInterface)
     (let [res (php/aget ds k)]
       (if (nil? res)
         opt
         res))

     ;; Vectors second, keeping the non-integer guard that stops `aget` coercing
     ;; the key and leaking a PHP warning. `integer?` and not `php/is_int`,
     ;; because a BigInt index is still an index.
     (php/instanceof ds PersistentVectorInterface)
     (if (integer? k)
       (let [res (php/aget ds k)]
         (if (nil? res)
           opt
           res))
       opt)

     ;; Transient maps third. They are not `PersistentMapInterface`, so before
     ;; this they fell through every branch to `:else`, seven predicates deep,
     ;; on a type that only appears inside `for :reduce` loops over transients
     ;; where the lookup runs once per element. `frequencies`, `group-by`,
     ;; `into` and `zipmap` all pay it.
     (php/instanceof ds TransientMapInterface)
     (let [res (php/aget ds k)]
       (if (nil? res)
         opt
         res))

     (nil? ds)                                                                                                                   opt
     (and (nil? k) (indexed? ds))                                                                                                opt

     ;; `set?` is `(php/instanceof x PersistentHashSetInterface)` and the
     ;; emitter inlines it to exactly that, so spelling it alongside the same
     ;; `php/instanceof` tested the identical thing twice per lookup.
     (or (set? ds)
         (php/instanceof ds TransientHashSetInterface))
     (if (.contains ds k)
       k
       opt)

    ;; Sequences index by int only; a non-integer key is simply absent
    ;; (Clojure returns the default). Guard before the loop's `php/<` /
    ;; `php/-` arithmetic, which would otherwise coerce the key to int and
    ;; leak a raw PHP int-coercion warning.
     (seq? ds)
     (if (integer? k)
       (loop [i k
              s ds]
         (if (or (nil? s) (php/< i 0))
           opt
           (if (php/=== i 0)
             (let [res (first s)]
               (if (nil? res)
                 opt
                 res))
             (recur (php/- i 1) (next s)))))
       opt)

    ;; Vectors index by int only; reject non-int keys before they reach
    ;; `aget`, which would otherwise trigger a raw PHP int-coercion
    ;; warning on `PersistentVector::offsetExists`.
     (and (indexed-vector? ds) (not (integer? k)))
     opt

     :else
     (let [res (php/aget ds k)]
       (if (nil? res)
         opt
         res)))))

(defn nth
  "Returns the value at `index` in `coll`. Throws an
   OutOfBoundsException if the index is out of range and no
   `not-found` value is supplied. For indexed collections (vectors,
   strings) this is O(1); for sequences it is O(n)."
  {:example "(nth [1 2 3] 1) ; => 2\n(nth [1 2 3] 5 :default) ; => :default"
   :see-also ["get" "first" "second"]}
  ([coll index]
   (cond
     (nil? coll)
     nil

     (not (integer? index))
     (throw (new OutOfBoundsException (str "Index " index " is not an integer")))

     (php/is_string coll)
     (if (in-bounds? index (php/mb_strlen coll "UTF-8"))
       (php/mb_substr coll index 1 "UTF-8")
       (throw (new OutOfBoundsException (str "String index " index " out of bounds"))))

     (indexed-vector? coll)
     (if (in-bounds? index (count coll))
       (get coll index)
       (throw (new OutOfBoundsException (str "Vector index " index " out of bounds"))))

     :else
     (loop [i index
            s coll]
       (cond
         (nil? s)      (throw (new OutOfBoundsException (str "Index " index " out of bounds")))
         (php/=== i 0) (first s)
         :else         (recur (php/- i 1) (next s))))))

  ([coll index not-found]
   (cond
     (nil? coll)            not-found

     (not (integer? index))
     not-found

     (php/is_string coll)
     (if (in-bounds? index (php/mb_strlen coll "UTF-8"))
       (php/mb_substr coll index 1 "UTF-8")
       not-found)

     (indexed-vector? coll)
     (if (in-bounds? index (count coll))
       (get coll index)
       not-found)

     :else
     (loop [i index
            s coll]
       (cond
         (nil? s)      not-found
         (php/=== i 0) (first s)
         :else         (recur (php/- i 1) (next s)))))))

(defn nthrest
  "Returns the nth rest of `coll`, `coll` when `n` is less than 1. Returns an empty list once the collection is exhausted."
  {:example "(nthrest [1 2 3 4 5] 2) ; => [3 4 5]\n(nthrest [1 2] 5) ; => ()\n(nthrest nil 0) ; => nil\n(nthrest nil 3) ; => ()"
   :see-also ["nth" "nthnext" "drop"]}
  [coll n]
  (if (php/< (NumericOperations/compare n 1) 0)
    coll
    (loop [i n
           s coll]
      (if (and (php/> (NumericOperations/compare i 0) 0) s)
        (recur (NumericOperations/subtract i 1) (next s))
        (if (nil? s) '() s)))))

(defn nthnext
  "Returns the nth next of `coll`, `(seq coll)` when `n` is 0. Returns nil if there are fewer than `n` elements remaining."
  {:example "(nthnext [1 2 3 4 5] 2) ; => (3 4 5)\n(nthnext [1 2] 5) ; => nil"
   :see-also ["nth" "nthrest" "drop"]}
  [coll n]
  (loop [i n
         s (seq coll)]
    (if (and (php/> i 0) s)
      (recur (php/- i 1) (next s))
      s)))

(defn- transient-set?
  [coll]
  (php/instanceof coll TransientHashSetInterface))

;; The persistent ops `conj`/`assoc`/`dissoc` intentionally also accept
;; transients: the fast `into`/`group-by` paths build by reducing `conj`/
;; `assoc` over a transient accumulator, so this polymorphism is load-bearing.
;; (Clojure throws here; Phel stays lenient by design — see clojure-test-suite
;; :phel divergences.) Reuse after `persistent!` is still rejected via the
;; transient's own invalidation guard.
(defn- vector-target?
  [coll]
  (or (php/instanceof coll PersistentVectorInterface) (transient-vector? coll)))

(defn- set-target?
  [coll]
  (or (php/instanceof coll PersistentHashSetInterface) (transient-set? coll)))

(defn- map-target?
  [coll]
  (or (php/instanceof coll PersistentMapInterface) (php/instanceof coll TransientMapInterface)))

(defn- vector-assoc
  "Updates a vector at an integer index. Vectors index by int only; a non-integer key raises a clean `InvalidArgumentException` instead of leaking PHP's `update(): Argument #1 ($i) must be of type int` TypeError."
  [v key value]
  (if (integer? key)
    (.update v key value)
    (throw (new InvalidArgumentException
                (str "assoc on a vector expects an integer index, got " (type key))))))

(defn- assoc-pair
  "Associates a single key-value pair with a collection."
  [ds key value]
  (cond
    ;; Clojure-compat: (assoc nil k v) creates a fresh map instead of erroring.
    (nil? ds)
    (.put {} key value)

    (php-array? ds)
    (throw (new InvalidArgumentException "Cannot call assoc on pure PHP arrays. Use (aset ds key value)"))

    (map-target? ds)
    (.put ds key value)

    (vector-target? ds)
    (vector-assoc ds key value)

    ;; MapEntry degrades to a 2-vector once mutated, since the result no
    ;; longer represents a real map entry. Matches Clojure's MapEntry
    ;; behavior under assoc.
    (php/instanceof ds MapEntry)
    (vector-assoc [(.key ds) (.value ds)] key value)

    ;; Explicit rejection for any other shape (string, list, set, sorted set,
    ;; number, …). Without this the old fall-through silently mutated strings
    ;; via `aset` and leaked raw PHP "offsetSet not supported" errors for
    ;; lists and sets.
    (throw (new InvalidArgumentException
                (str "assoc expects a map, vector, struct, or nil; got " (type ds))))))

(defn assoc
  "Associates one or more key-value pairs with a collection. Additional key-value pairs beyond the first are applied in order. Throws if an odd number of extra arguments is provided."
  {:example "(assoc {:a 1} :b 2) ; => {:a 1, :b 2}\n(assoc {:a 1} :b 2 :c 3) ; => {:a 1, :b 2, :c 3}"}
  ;; The three-argument call is nearly every call, and its whole work is one
  ;; `assoc-pair`. On the variadic form it also allocated `more`, counted it,
  ;; bit-tested the count and entered a loop whose first act was `empty?`.
  ([ds key value] (assoc-pair ds key value))
  ([ds key value & more]
   (when (php/!== 0 (php/& (count more) 1))
     (throw (new InvalidArgumentException
                 (str "assoc expects an even number of extra arguments (key-value pairs), got "
                      (count more)))))
   (loop [acc       (assoc-pair ds key value)
          remaining more]
     (if (empty? remaining)
       acc
       (recur (assoc-pair acc (first remaining) (second remaining))
              (rest (rest remaining)))))))

(defn- dissoc-one
  [ds key]
  (cond
    (php/=== nil ds)
    nil

    (php/is_array ds)
    (throw (new InvalidArgumentException "Cannot call dissoc on pure PHP arrays. Use (php/aunset ds key)"))

    (map-target? ds)
    (.remove ds key)

    (set-target? ds)
    (.remove ds key)

    (throw (new InvalidArgumentException
                (str "dissoc requires a map, set, or struct; got " (type ds))))))

(defn dissoc
  "Returns `ds` without the given keys. With no keys returns `ds` unchanged."
  {:example "(dissoc {:a 1 :b 2} :b) ; => {:a 1}\n(dissoc {:a 1 :b 2 :c 3} :a :c) ; => {:b 2}"}
  ;; Fixed arities: removing one key is the call that actually happens, and it
  ;; needed neither the rest argument nor the loop to find that out (#2973,
  ;; #3021).
  ([ds] ds)
  ([ds k] (dissoc-one ds k))
  ([ds k & ks]
   (loop [acc       (dissoc-one ds k)
          remaining ks]
     (if (empty? remaining)
       acc
       (recur (dissoc-one acc (first remaining)) (next remaining))))))
